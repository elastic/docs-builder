{
  "openapi": "3.0.3",
  "info": { "title": "Document security fixture", "version": "1.0.0" },
  "security": [{ "apiKey": [] }, { "basicAuth": [] }],
  "tags": [{ "name": "access" }, { "name": "other" }],
  "x-tagGroups": [
    { "name": "Access", "tags": ["access"] },
    { "name": "Other", "tags": ["other"] }
  ],
  "paths": {
    "/inherits": {
      "get": {
        "operationId": "inherits",
        "summary": "Inherits the document security",
        "tags": ["access"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/repeats": {
      "get": {
        "operationId": "repeats",
        "summary": "Repeats the document security in another order",
        "tags": ["access"],
        "security": [{ "basicAuth": [] }, { "apiKey": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/narrows": {
      "get": {
        "operationId": "narrows",
        "summary": "Accepts a bearer token only",
        "tags": ["access"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/optional": {
      "get": {
        "operationId": "optional",
        "summary": "Accepts no credentials or an API key",
        "tags": ["access"],
        "security": [{}, { "apiKey": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/relaxes": {
      "get": {
        "operationId": "relaxes",
        "summary": "Accepts the document's credentials or none",
        "tags": ["access"],
        "security": [{}, { "apiKey": [] }, { "basicAuth": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/anonymous": {
      "get": {
        "operationId": "anonymous",
        "summary": "Needs no authentication",
        "tags": ["other"],
        "security": [],
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "in": "header", "name": "Authorization", "description": "Send the encoded key with the ApiKey prefix." },
      "basicAuth": { "type": "http", "scheme": "basic" },
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
