# What a content page shows: its heading and lead paragraph, and a picture of the whole article.
# The article's link tree is left out: a link to www.elastic.co reads as {origin} on prod and as itself elsewhere, so
# the same page would differ depending on which sites are compared.
# @tags compare
# @requires build-type:assembler compare
set viewport 1280 800
open get-started
wait --load networkidle
get title
snapshot -c -s "#markdown-content h1"
get text "#markdown-content section > p:not(.applies)"
screenshot "#markdown-content" content-page.png
