# @requires build-type:isolated
set viewport 1280 800
open /syntax/code
wait --load networkidle
expect visible find role contentinfo
expect visible find role link --name "Terms of Use"
expect visible find role link --name "Privacy"
expect attr "footer.bg-ink-dark a[href*='terms-of-use']" href https://www.elastic.co/legal/terms-of-use
expect attr "footer.bg-ink-dark a[href*='privacy']" href https://www.elastic.co/legal/privacy-statement
expect text "footer.bg-ink-dark" "All Rights Reserved" --contains
