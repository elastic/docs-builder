<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="$(NulleanEntitiesProject)" />
      <ProjectReference Include="$(NulleanEntitiesGeneratorProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Elastic.Documentation.OpenApiIndex.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.CloudFront" />
      <PackageReference Include="AWSSDK.S3" />
    </ItemGroup>

</Project>
