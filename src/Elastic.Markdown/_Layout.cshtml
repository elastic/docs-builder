@inherits RazorLayoutSlice<MarkdownLayoutViewModel>
@using Elastic.Markdown
@using Elastic.Documentation.Configuration.Toc
@using Elastic.Documentation.Site.Components.Breadcrumb
@using Elastic.Documentation.Site.Components.CtaCard
@using Elastic.Documentation.Site.Components.PageActions
@using Elastic.Documentation.Site.Components.Pager
@using Elastic.Documentation.Site.Components.Toc
@implements IUsesLayout<Elastic.Documentation.Site._GlobalLayout, GlobalLayoutViewModel>
@functions {
	public GlobalLayoutViewModel LayoutModel => Model;
	protected override async Task ExecuteSectionAsync(string name)
	{
		if (name == GlobalSections.Footer && Model.Layout is not MarkdownPageLayout.Archive)
		{
			//this ensures we forward footer sections declared in this project into to GlobalLayout view's section
			await RenderSectionAsync(GlobalSections.Footer);
		}

		if (name == GlobalSections.Head)
		{
			if (Model.RedirectUrl is { } redirectUrl && Model.Layout is not MarkdownPageLayout.Archive)
			{
				var encodedUrl = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(redirectUrl);
				<script>window.location.replace('@(new HtmlString(encodedUrl))');</script>
			}
			//this ensures we forward head sections declared in this project into to GlobalLayout view's section
			await RenderSectionAsync(GlobalSections.Head);
		}
	}
	private bool RenderHeaderAndFooter => Model.Layout is not MarkdownPageLayout.FullSearch;

	private static string StripBadge(string title) =>
		title.StartsWith("[ns]", StringComparison.Ordinal) ? title[4..] :
		title.StartsWith("[cmd]", StringComparison.Ordinal) ? title[5..] : title;

	private BreadcrumbModel? DesignSystemBreadcrumbs()
	{
		var items = Model.Breadcrumbs;
		if (items.Length == 0 || !(items.Length > 1 || Model.BuildType != BuildType.Isolated))
			return null;
		return new BreadcrumbModel
		{
			Items = [.. items.Select((item, i) => i == items.Length - 1 ? new BreadcrumbItem(StripBadge(item.NavigationTitle)) : new BreadcrumbItem(StripBadge(item.NavigationTitle), item.Url))]
		};
	}

	private bool ShowsContributionLinks => Model.Features.PrimaryNavEnabled && Model.BuildType != BuildType.Codex && Model.Branding is null;

	private bool ShowsCta => Model.BuildType != BuildType.Codex && (Model.Cta.Name != Cta.DefaultName || (Model.BuildType == BuildType.Assembler && Model.Branding is null));

	private async Task RenderDesignSystemPage(bool hub)
	{
		var breadcrumbs = hub ? null : DesignSystemBreadcrumbs();
		<div class="docs-shell@(hub ? " docs-shell--hub" : "")">
			<input class="docs-shell__drawer-toggle" type="checkbox" id="pages-nav-hamburger">
			<label class="docs-shell__scrim" for="pages-nav-hamburger" aria-hidden="true"></label>
			<aside class="docs-shell__nav" id="pages-nav">
				@(new HtmlString(Model.NavigationHtml))
			</aside>
			<div class="docs-shell__main">
				<main id="content-container" class="docs-shell__content">
					<label class="docs-shell__menu-button" for="pages-nav-hamburger">
						@await RenderPartialAsync(Elastic.Documentation.Site.Components.Icon._Icon.Create(new Elastic.Documentation.Site.Components.Icon.IconModel { Name = "menu", Size = Elastic.Documentation.Site.Components.Icon.IconSize.Small }))
						<span>Menu</span>
					</label>
					@if (breadcrumbs is not null)
					{
						@await RenderPartialAsync(_Breadcrumb.Create(breadcrumbs))
					}
					<article id="markdown-content" class="@(hub ? "hub-content" : "prose") min-w-0" data-pagefind-body>
						@await RenderBodyAsync()
					</article>
					@if (!hub)
					{
						@await RenderPartialAsync(_PageFeedback.Create(Model))
						@await RenderPartialAsync(_Pager.Create(new PagerModel
						{
							Previous = Model.Previous is { } previous ? new PagerLink(StripBadge(previous.NavigationTitle), previous.Url) : null,
							Next = Model.Next is { } next ? new PagerLink(StripBadge(next.NavigationTitle), next.Url) : null
						}))
					}
					@if (Model.Features.WebsiteSearchEnabled && Model.Features.WebsiteSearchScriptUrl is not null)
					{
						<div id="elastic-website-search-input-container" hx-preserve="true" class="docs-shell__search"></div>
					}
				</main>
				@if (!hub)
				{
					<aside class="docs-shell__rail">
						@await RenderPartialAsync(_PageActions.Create(new PageActionsModel
						{
							MarkdownUrl = Model.MarkdownUrl,
							ReportIssueUrl = ShowsContributionLinks ? Model.ReportIssueUrl : null,
							EditUrl = !string.IsNullOrEmpty(Model.GithubEditUrl) && !Model.HideEditThisPage ? Model.GithubEditUrl : null,
							ContributeUrl = ShowsContributionLinks ? "https://www.elastic.co/docs/contribute-docs/" : null
						}))
						@if (ShowsCta)
						{
							@await RenderPartialAsync(_CtaCard.Create(new CtaCardModel { Label = Model.Cta.Label, Url = Model.Cta.Url, Name = Model.Cta.Name, Benefits = [.. Model.Cta.Benefits] }))
						}
						@await RenderPartialAsync(_Toc.Create(new TocModel { Items = [.. Model.PageTocItems.Select(i => new TocItem(i.Heading, i.Slug, i.Level))] }))
					</aside>
				}
			</div>
		</div>
	}

	private async Task RenderDefault()
	{
		if (Model.Features.NavigationPreviewEnabled)
		{
			await RenderDesignSystemPage(hub: false);
			return;
		}

		<div class="relative">
			
			<div class="min-h-screen
						w-full
						max-w-(--max-layout-width)
						mx-auto
						md:px-4
			">
				<div class="min-h-screen grid grid-cols-1 md:grid-cols-[var(--max-sidebar-width)_1fr] gap-6">
					<main id="content-container" class="min-w-0 flex flex-col lg:grid lg:grid-cols-[minmax(0,var(--max-text-width))_minmax(0,var(--max-sidebar-width))] lg:justify-end lg:gap-4 mx-4 md:col-start-2 md:row-start-1">
						<div class="mb-9 mt-0 min-w-0 order-2 lg:order-1">
							@await RenderPartialAsync(_Breadcrumbs.Create(new BreadcrumbsView(Model.Breadcrumbs, Model.BuildType)))
							<article id="markdown-content" class="markdown-content min-w-0" data-pagefind-body>
								<input type="checkbox" class="hidden" id="pages-nav-hamburger">
								@await RenderBodyAsync()
							</article>
							@await RenderPartialAsync(_PageFeedback.Create(Model))
							@await RenderPartialAsync(_PrevNextNav.Create(Model))
							@if (Model.Features.WebsiteSearchEnabled && Model.Features.WebsiteSearchScriptUrl is not null)
							{
								<div id="elastic-website-search-input-container"
								     hx-preserve="true"
								     class="sticky bottom-8 mt-8 z-40">
								</div>
							}
						</div>
						@await RenderPartialAsync(_TableOfContents.Create(Model))
					</main>
					@await RenderPartialAsync(_PagesNav.Create(Model))
				</div>
			</div>
		</div>
	}

	@* Hub pages are composed entirely from directives and own the full content column.
	   They drop the right-rail table of contents and the prev/next nav, but keep the
	   pages nav so a reader can move between sibling hubs. *@
	private async Task RenderHub()
	{
		if (Model.Features.NavigationPreviewEnabled)
		{
			await RenderDesignSystemPage(hub: true);
			return;
		}

		<div class="relative hub-page">
			<div class="min-h-screen
						w-full
						max-w-(--max-layout-width)
						mx-auto
						md:px-4
			">
				<div class="min-h-screen grid grid-cols-1 md:grid-cols-[var(--max-sidebar-width)_1fr] gap-6">
					<main id="content-container" class="min-w-0 mx-4 md:col-start-2 md:row-start-1">
						@* Keeps the markdown-content id, which hljs, smooth-scroll and toc-nav select on,
						   but not the class. typography.css is unlayered and hub.css sits in @@layer
						   components, so the class would override every hub rule regardless of
						   specificity. Hub directives bring their own typography. *@
						<article id="markdown-content" class="hub-content min-w-0" data-pagefind-body>
							<input type="checkbox" class="hidden" id="pages-nav-hamburger">
							@await RenderBodyAsync()
						</article>
					</main>
					@await RenderPartialAsync(_PagesNav.Create(Model))
				</div>
			</div>
		</div>
	}

	private async Task RenderLanding()
	{
		<div class="relative">
			@if (Model.HasMobilePagesNavContent)
			{
				<input type="checkbox" class="hidden" id="pages-nav-hamburger">
				<label role="button" class="absolute left-4 top-3 z-10 md:hidden cursor-pointer" for="pages-nav-hamburger">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
					     stroke="currentColor" class="size-6">
						<path stroke-linecap="round" stroke-linejoin="round"
						      d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"/>
					</svg>
				</label>
			}
			@await RenderPartialAsync(_LandingPage.Create(Model))
			@if (Model.HasMobilePagesNavContent)
			{
				<div class="md:hidden">
					@await RenderPartialAsync(_PagesNav.Create(Model))
				</div>
			}
		</div>
	}

}

@if (RenderHeaderAndFooter)
{
	if (Model.BuildType == BuildType.Assembler)
	{
		@(await RenderPartialAsync(_AssemblerHeader.Create(Model)))

	}
	else if (Model.Features.NavigationPreviewEnabled)
	{
		@(await RenderPartialAsync(_DesignSystemHeader.Create(Model)))
	}
	else
	{
		@(await RenderPartialAsync(_IsolatedHeader.Create(Model)))
	}
}
<div id="main-container">
@switch (Model.Layout)
{
	case MarkdownPageLayout.NotFound:
		await RenderPartialAsync(_NotFound.Create(Model));
		break;
	case MarkdownPageLayout.LandingPage:
		await RenderLanding();
		break;
	case MarkdownPageLayout.Archive:
		await RenderPartialAsync(_Archive.Create(Model));
		break;
	case MarkdownPageLayout.FullSearch:
		await RenderPartialAsync(_FullSearch.Create(Model));
		break;
	case MarkdownPageLayout.Hub:
		await RenderHub();
		break;
	default:
		await RenderDefault();
		break;
}
</div>
@if (Model.Features.WebsiteSearchEnabled && Model.Features.WebsiteSearchScriptUrl is not null)
{
	<elastic-website-search
		nav-mode="on"
		chat-enabled="true"
		chat-mode="input"
		chat-input-container="#elastic-website-search-input-container">
	</elastic-website-search>
}
@if (RenderHeaderAndFooter)
{
	if (Model.Features.NavigationPreviewEnabled)
	{
		@(await RenderPartialAsync(_DesignSystemFooter.Create(Model)))
	}
	else if (Model.BuildType == BuildType.Assembler)
	{
		@(await RenderPartialAsync(_AssemblerFooter.Create(Model)))
	}
	else
	{
		@(await RenderPartialAsync(_IsolatedFooter.Create(Model)))
	}
}
