@inherits RazorSlice<Elastic.Markdown.Components.AppliesPopover.AppliesPopoverModel>
@if (Model.Interactive && Model.Popover is { } inlineContent && !Model.Block)
{
	@* Inside a paragraph, so only phrasing content: a details, div, p or ul start tag would close the paragraph and split the sentence. *@
	<span class="applies-popover applies-popover--inline" data-applies-popover>
		<button type="button" class="@Model.CssClass applies-popover__trigger" aria-expanded="false" data-applies-trigger>
			@await RenderPartialAsync(_AppliesPopoverBadge.Create(Model))
		</button>
		<span class="applies-popover__panel" data-applies-panel>
			@if (inlineContent.ProductDescription is { } inlineDescription)
			{
				<span class="applies-popover__description">@inlineDescription</span>
			}
			@if (inlineContent.Availability.Count > 0)
			{
				<span class="applies-popover__heading">Availability</span>
				<span class="applies-popover__availability" role="list">
					@foreach (var item in inlineContent.Availability)
					{
						<span class="applies-popover__item" role="listitem">
							<span class="applies-popover__item-name">@item.Text</span>
							@if (item.LifecycleDescription is { Length: > 0 } itemDescription)
							{
								<span class="applies-popover__item-description">@itemDescription</span>
							}
						</span>
					}
				</span>
			}
			@if (inlineContent.AdditionalInfo is { Length: > 0 } inlineInfo)
			{
				<span class="applies-popover__info">@inlineInfo</span>
			}
			@if (inlineContent.VersionNote is { } inlineNote)
			{
				<span class="applies-popover__note">@inlineNote</span>
			}
		</span>
	</span>
}
else if (Model.Interactive && Model.Popover is { } content)
{
	<details class="applies-popover" data-menu data-popover>
		<summary class="@Model.CssClass applies-popover__trigger">
			@await RenderPartialAsync(_AppliesPopoverBadge.Create(Model))
		</summary>
		<div class="applies-popover__panel" data-popover-panel>
			@if (content.ProductDescription is { } description)
			{
				<p class="applies-popover__description">@description</p>
			}
			@if (content.Availability.Count > 0)
			{
				<p class="applies-popover__heading">Availability</p>
				<ul class="applies-popover__availability">
					@foreach (var item in content.Availability)
					{
						<li>
							@if (item.LifecycleDescription is { Length: > 0 } lifecycleDescription)
							{
								<details class="applies-popover__item">
									<summary>@item.Text</summary>
									<p>@lifecycleDescription</p>
								</details>
							}
							else
							{
								<span>@item.Text</span>
							}
						</li>
					}
				</ul>
			}
			@if (content.AdditionalInfo is { Length: > 0 } additionalInfo)
			{
				<p class="applies-popover__info">@additionalInfo</p>
			}
			@if (content.VersionNote is { } versionNote)
			{
				<p class="applies-popover__note">@versionNote</p>
			}
		</div>
	</details>
}
else
{
	<span class="@Model.CssClass">
		@await RenderPartialAsync(_AppliesPopoverBadge.Create(Model))
	</span>
}
