@inherits RazorSlice<Elastic.Markdown.Myst.Directives.Image.ImageViewModel>
@{
	var dialogLabel = string.IsNullOrEmpty(Model.Alt) ? "Image preview" : $"Image preview: {Model.Alt}";
}
<button type="button"
	class="reference internal image-reference image-dialog-trigger"
	data-image-dialog-open
	aria-controls="modal-@Model.UniqueImageId"
	aria-label="@dialogLabel">
	<img loading="lazy" title="@Model.Title" alt="@(Model.Alt == string.Empty ? HtmlString.Empty : new HtmlString(Model.Alt))" src="@Model.ImageUrl" style="@Model.Style" class="@Model.Screenshot" />
</button>
@Model.RenderBlock()

<dialog id="modal-@Model.UniqueImageId" class="modal" data-image-dialog aria-label="@dialogLabel">
	<div class="modal-content">
		<button type="button" class="modal-close" data-image-dialog-close aria-label="Close image preview">
			<span aria-hidden="true">&times;</span>
		</button>
		<a class="reference internal image-reference" href="@Model.ImageUrl" target="_blank" rel="noopener" aria-label="Open full-size image in a new tab">
			<img loading="lazy" title="@Model.Title"  alt="@(Model.Alt == string.Empty ? HtmlString.Empty : new HtmlString(Model.Alt))" src="@Model.ImageUrl" />
		</a>
	</div>
</dialog>
