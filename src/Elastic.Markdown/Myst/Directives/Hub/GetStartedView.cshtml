@inherits RazorSlice<Elastic.Markdown.Myst.Directives.Hub.GetStartedViewModel>

<section class="hub-get-started" id="get-started">
	<div class="hub-get-started-lead">
		@if (!string.IsNullOrWhiteSpace(Model.Title))
		{
			<h2 class="hub-get-started-title">@Model.Title</h2>
		}
		@if (!string.IsNullOrWhiteSpace(Model.IntroHtml))
		{
			<p class="hub-get-started-intro">@(new HtmlString(Model.IntroHtml))</p>
		}
	</div>

	@if (Model.Steps.Count > 0)
	{
		<div class="hub-get-started-track" style="--hub-step-columns: @Model.StepColumns; --hub-solo-share: @Model.SoloShare">
			@{ var seenStep = false; }
			@foreach (var row in Model.Rows)
			{
				var solo = row.Count == 1 && row[0].Options.Count == 0;
				var fork = row.Count == 1 && row[0].Options.Count > 0;
				var rowClass = "hub-get-started-row" + (solo ? " hub-get-started-row-solo" : "") + (fork ? " hub-get-started-row-fork" : "");
				<ol class="@rowClass">
					@for (var index = 0; index < row.Count; index++)
					{
						var step = row[index];
						var flat = row.Count == 1 || (!seenStep && index == 0);
						var stepClass = "hub-get-started-step" + (flat ? " is-flat" : "") + (step.Options.Count > 0 ? " is-fork" : "");
						seenStep = true;
						<li class="@stepClass">
							<span class="hub-get-started-step-num" aria-hidden="true">@step.Number</span>
							@if (step.Options.Count == 2)
							{
								<div class="hub-get-started-fork-lead">
									@if (!string.IsNullOrWhiteSpace(step.Title))
									{
										<h3 class="hub-get-started-step-title">@step.Title</h3>
									}
									@if (!string.IsNullOrWhiteSpace(step.DescriptionHtml))
									{
										<p class="hub-get-started-step-desc">@(new HtmlString(step.DescriptionHtml))</p>
									}
								</div>
								<div class="hub-get-started-option hub-get-started-option-left">
									@OptionBody(step.Options[0])
								</div>
								<div class="hub-get-started-or" aria-hidden="true"><span>or</span></div>
								<div class="hub-get-started-option hub-get-started-option-right">
									@OptionBody(step.Options[1])
								</div>
							}
							else
							{
								<div class="hub-get-started-step-body">
									@if (!string.IsNullOrWhiteSpace(step.Title))
									{
										<h3 class="hub-get-started-step-title">@step.Title</h3>
									}
									@if (!string.IsNullOrWhiteSpace(step.DescriptionHtml))
									{
										<p class="hub-get-started-step-desc">@(new HtmlString(step.DescriptionHtml))</p>
									}
									@if (step.Options.Count > 0)
									{
										<div class="hub-get-started-options">
											@foreach (var option in step.Options)
											{
												<div class="hub-get-started-option">
													@OptionBody(option)
												</div>
											}
										</div>
									}
									else if (!string.IsNullOrWhiteSpace(step.Link))
									{
										<a class="hub-get-started-step-arrow" @Model.LinkAttributes(step.Link)>
											<span>@(string.IsNullOrWhiteSpace(step.LinkLabel) ? "Open" : step.LinkLabel)</span>
											<svg class="hub-arrow" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"/>
											</svg>
										</a>
									}
								</div>
							}
						</li>
					}
				</ol>
			}
		</div>
	}
</section>

@functions {
	private Microsoft.AspNetCore.Html.IHtmlContent OptionBody(Elastic.Markdown.Myst.Directives.Hub.GetStartedOptionViewModel option)
	{
		var builder = new System.Text.StringBuilder();
		using var writer = new System.IO.StringWriter(builder);
		if (!string.IsNullOrWhiteSpace(option.Label))
			writer.Write($"<span class=\"hub-get-started-option-label\">{System.Net.WebUtility.HtmlEncode(option.Label)}</span>");
		if (!string.IsNullOrWhiteSpace(option.DescriptionHtml))
			writer.Write($"<p class=\"hub-get-started-option-desc\">{option.DescriptionHtml}</p>");
		if (!string.IsNullOrWhiteSpace(option.Code))
		{
			var language = string.IsNullOrWhiteSpace(option.Language) ? "text" : option.Language;
			writer.Write("<div class=\"hub-get-started-install highlight\"><pre><code class=\"language-");
			writer.Write(System.Net.WebUtility.HtmlEncode(language));
			writer.Write("\">");
			writer.Write(System.Net.WebUtility.HtmlEncode(option.Code));
			writer.Write("</code></pre></div>");
		}
		if (!string.IsNullOrWhiteSpace(option.Url))
		{
			if (!string.IsNullOrWhiteSpace(option.Code))
			{
				writer.Write("<a class=\"hub-get-started-option-link\" ");
				writer.Write(Model.LinkAttributes(option.Url));
				writer.Write("><span>");
				writer.Write(System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(option.UrlLabel) ? "Learn more" : option.UrlLabel));
				writer.Write("</span><svg class=\"hub-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3\"/></svg></a>");
			}
			else
			{
				writer.Write("<a class=\"hub-get-started-option-btn\" ");
				writer.Write(Model.LinkAttributes(option.Url));
				writer.Write(">");
				writer.Write(System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(option.UrlLabel) ? "Get started" : option.UrlLabel));
				writer.Write("</a>");
			}
		}
		return new HtmlString(builder.ToString());
	}
}
