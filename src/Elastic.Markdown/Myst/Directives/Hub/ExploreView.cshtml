@inherits RazorSlice<Elastic.Markdown.Myst.Directives.Hub.ExploreViewModel>

<div class="hub-zone@(Model.HeadingLevel > 2 ? " hub-zone-nested" : "")" @(string.IsNullOrWhiteSpace(Model.Anchor) ? "" : $"id={Model.Anchor}")>
	@* The tag name is the only thing that varies, so the title text still goes through Razor encoding. *@
	@(new HtmlString($"<h{Model.HeadingLevel} class=\"hub-zone-title\">"))@Model.Title@(new HtmlString($"</h{Model.HeadingLevel}>"))
	@if (!string.IsNullOrWhiteSpace(Model.Intro))
	{
		<p class="hub-zone-intro">@Model.Intro</p>
	}
</div>
<div class="hub-explore">
	@Model.RenderBlock()
</div>
