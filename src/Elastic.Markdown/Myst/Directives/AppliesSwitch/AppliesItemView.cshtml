@using Elastic.Markdown.Myst.Directives.AppliesSwitch
@inherits RazorSlice<Elastic.Markdown.Myst.Directives.AppliesSwitch.AppliesItemViewModel>

@if (Model.IsDropdown)
{
	@* The parent switch view renders the inputs and labels grouped in the
	   selector overlay; the item only contributes its content pane. *@
	<div class="applies-switch-content@(Model.Checked ? " applies-switch-content--active" : "")" data-index="@Model.Index" tabindex="0">
		@Model.RenderBlock()
	</div>
}
else
{
	@await RenderPartialAsync(AppliesItemLabelView.Create(Model))
	<div class="applies-switch-content" tabindex="0">
		@Model.RenderBlock()
	</div>
}
