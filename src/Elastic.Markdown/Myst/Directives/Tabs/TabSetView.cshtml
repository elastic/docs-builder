@inherits RazorSlice<Elastic.Markdown.Myst.Directives.Tabs.TabSetViewModel>
@{
	var asDropdown = Model.RenderAsDropdown && Model.Options.Count > 1;
	var label = $"Select {Model.GroupKey?.Replace('-', ' ') ?? "option"}";
}
<div class="tabs@(asDropdown ? " tabs-dropdown" : "")">
	@if (asDropdown)
	{
		@* Hidden until tabs.ts activates it, so the tab strip stays usable without JS. *@
		<div class="tabs-select-wrapper" hidden>
			<select class="tabs-select" data-sync-group="@Model.GroupKey" aria-label="@label">
				@foreach (var option in Model.Options)
				{
					<option value="@option.InputId" data-sync-id="@option.SyncKey">@option.Title</option>
				}
			</select>
		</div>
	}
	@Model.RenderBlock()
</div>
