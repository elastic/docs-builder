@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@using Elastic.Documentation.Site.Components.Chrome.Feedback
@* Outside #main-container, so no boosted swap carries it. api-beta-banner.ts matches it to each new page.
   Where page feedback runs, the feedback link opens it in a dialog; elsewhere, and without script, it stays a link to the issue form. *@
@{
	const string dialogId = "api-beta-feedback";
	var opensDialog = Model.ShowPageFeedback;
}
<aside id="api-beta-banner" class="api-beta-banner" aria-label="About this API reference">
	<p class="api-beta-banner__message">We've rebuilt the Elastic API reference with a fresh design. @if (opensDialog){<a class="api-beta-banner__link" href="@Model.BetaBanner.FeedbackUrl" data-api-beta-feedback-open="@dialogId" aria-haspopup="dialog">Share your feedback</a>}else{<a class="api-beta-banner__link" href="@Model.BetaBanner.FeedbackUrl">Share your feedback</a>}.</p>
	@if (opensDialog)
	{
		<dialog class="api-beta-feedback" id="@dialogId" aria-labelledby="@(dialogId)-title">
			<header class="api-beta-feedback__header">
				<h2 class="api-beta-feedback__title" id="@(dialogId)-title">Feedback on this page</h2>
				<form method="dialog"><button class="api-beta-feedback__close" type="submit" aria-label="Close"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg></button></form>
			</header>
			<div class="api-beta-feedback__content">
			<p class="api-beta-feedback__intro">Tell us what looks wrong or is missing.</p>
			@if (Model.Features.NavigationPreviewEnabled)
			{
				@await RenderPartialAsync(_Feedback.Create(new FeedbackModel
				{
					PageUrl = Model.CurrentNavigationItem.Url,
					PageTitle = Model.Title,
					ApiBase = Model.FrontendConfig.ApiBasePath,
					Surface = FeedbackSurface.Api,
					Id = dialogId
				}))
			}
			else
			{
				<page-feedback page-url="@Model.CurrentNavigationItem.Url" page-title="@Model.Title" surface="@Model.PageFeedbackSurface"></page-feedback>
			}
			</div>
		</dialog>
	}
</aside>
