@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@using Elastic.Documentation.Site.Components.Navigation.LinkMenu
@{
	var apiContext = Model.ApiContext;
}
@* The API sidebar: the switchers above the shared navigation tree. The jump field filters the tree and needs script, so it stays hidden until then. *@
<div class="api-sidebar-chrome" data-nav-filter-scope>
	@if (apiContext is not null && apiContext.Versions.Count > 1)
	{
		@await RenderPartialAsync(_LinkMenu.Create(new LinkMenuModel
		{
			Label = "API version",
			Items = [.. apiContext.Versions.Select(item => new LinkMenuItem(item.Label, item.Value, item.Selected))]
		}))
	}
	@if (apiContext is not null && apiContext.Products.Count > 0 && Model.BuildType != BuildType.Assembler)
	{
		@await RenderPartialAsync(_LinkMenu.Create(new LinkMenuModel
		{
			Label = "API product",
			Items = [.. apiContext.Products.Select(item => new LinkMenuItem(item.Label, item.Url, item.Selected))]
		}))
	}
	@if (Model.ShowJumpToPage)
	{
		<input class="input api-sidebar-chrome__filter" type="search" placeholder="Jump to API" aria-label="Jump to API" autocomplete="off" data-nav-filter hidden>
	}
	@(new HtmlString(Model.NavigationHtml))
</div>
