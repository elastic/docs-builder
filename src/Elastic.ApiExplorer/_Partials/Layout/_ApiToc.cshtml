@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.TocItem>>
@* On this page for the right rail: the docs pages' list. api-rail-toc hides it below 1024px, where the API rail sits under the
   article, and data-toc lets the design system bundle's scroll spy (ds/toc.ts) take the list over there. *@
@if (Model.Count > 0)
{
	<nav id="toc-nav" class="api-rail-toc" aria-label="On this page" data-toc>
		@await RenderPartialAsync(_PageToc.Create(Model))
	</nav>
}
