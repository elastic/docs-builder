@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.TocItem>>
@* "On this page" in the right rail of schema and structural pages: the docs rail list. Below 1024px the rail sits under the
   article, where a jump list is no use. *@
@if (Model.Count > 0)
{
	<nav id="toc-nav" class="sidebar hidden min-[1024px]:block" aria-label="On this page">
		@await RenderPartialAsync(_PageToc.Create(Model))
	</nav>
}
