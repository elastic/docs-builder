@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.TocItem>>
@* On this page for the right rail: the docs pages' list, sized by .api-rail-toc. Each stylesheet hides it where the rail sits under
   the article. data-toc and the list's data-toc-link feed the design system scroll spy. *@
@if (Model.Count > 0)
{
	<nav id="toc-nav" class="api-rail-toc" aria-label="On this page" data-toc>
		@await RenderPartialAsync(_PageToc.Create(Model))
	</nav>
}
