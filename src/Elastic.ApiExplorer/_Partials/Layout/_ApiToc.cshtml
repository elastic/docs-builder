@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.TocItem>>
@* On this page for the right rail: the docs pages' list. api-rail-toc and data-toc are the design system bundle's hooks; its
   CSS and scroll spy (ds/toc.ts) take over the list there. *@
@if (Model.Count > 0)
{
	<nav id="toc-nav" class="api-rail-toc" aria-label="On this page" data-toc>
		@await RenderPartialAsync(_PageToc.Create(Model))
	</nav>
}
