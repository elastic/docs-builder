@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<OperationExamplesPanelModel>
@* Second column of .api-page-columns from 1024px (api-docs.css); stacked under the reference below that.
   Example chips pick a scenario; inactive scenarios use hidden="until-found" so find-in-page still reaches them. *@
<aside id="api-examples-panel">
	<nav class="api-examples-panel-nav markdown-content simple-scrollbar">
		<div class="api-examples" data-api-examples>
			<p class="api-examples-heading" id="api-examples-heading">Examples</p>
			@if (Model.Scenarios.Count > 1)
			{
				<div class="api-example-chips" role="tablist" aria-labelledby="api-examples-heading">
					@for (var i = 0; i < Model.Scenarios.Count; i++)
					{
						var scenario = Model.Scenarios[i];
						var count = scenario.CodeSamples.Count;
						<button
							type="button"
							role="tab"
							class="api-example-chip@(i == 0 ? " is-active" : "")"
							data-scenario="@scenario.TabId"
							aria-selected="@(i == 0 ? "true" : "false")">
							<span class="api-example-chip-title">@scenario.Title</span>
							@if (count > 0)
							{
								var noun = count == 1 ? "language" : "languages";
								<span class="api-example-chip-count" title="@count @noun">
									<svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M5.3 4.3 1.6 8l3.7 3.7.7-.7L3 8l3-3-.7-.7Zm5.4 0-.7.7 3 3-3 3 .7.7L14.4 8l-3.7-3.7ZM9.2 2.5 6.5 13.5l1 .25 2.7-11-1-.25Z"/></svg>@count<span class="sr-only"> @noun</span>
								</span>
							}
						</button>
					}
				</div>
			}
			@for (var i = 0; i < Model.Scenarios.Count; i++)
			{
				var scenario = Model.Scenarios[i];
				<div class="api-examples-scenario-panel api-examples-body" data-scenario="@scenario.TabId" hidden="@(i == 0 ? null : "until-found")">
					@(await RenderPartialAsync<_ExampleScenarioContent, ExampleScenarioView>(new ExampleScenarioView(scenario, Model)))
				</div>
			}
		</div>
	</nav>
</aside>
