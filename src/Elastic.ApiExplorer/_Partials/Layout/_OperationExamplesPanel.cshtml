@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<OperationExamplesPanelModel>
@* Second column of .api-page-columns from 1024px (api-docs.css); stacked under the reference below that. *@
<aside id="api-examples-panel">
	<nav class="api-examples-panel-nav markdown-content simple-scrollbar">
		@if (Model.Scenarios.Count == 1)
		{
			<div class="api-examples-body">
				@(await RenderPartialAsync<_ExampleScenarioContent, ExampleScenario>(Model.Scenarios[0]))
			</div>
		}
		else if (Model.Scenarios.Count > 1)
		{
			var multiLanguage = Model.Scenarios.Where(static scenario => scenario.CodeSamples.Count > 1).ToArray();
			var shared = multiLanguage.Length == 1 ? multiLanguage[0] : null;
			<div class="api-examples-scenarios" data-api-scenarios>
				@if (shared is not null)
				{
					var sharedOptions = Model.Scenarios
						.Select(choice => new ApiSelectOption(choice.Title, choice.TabId, choice.TabId == Model.Scenarios[0].TabId))
						.ToArray();
					@(await RenderPartialAsync<_ApiCodeSample, ApiCodeSampleModel>(new ApiCodeSampleModel($"rail-{shared.TabId}", shared.CodeSamples, shared.HttpMethod, shared.Route, sharedOptions)))
				}
				@for (var i = 0; i < Model.Scenarios.Count; i++)
				{
					var scenario = Model.Scenarios[i];
					var rendered = shared is null
						? scenario with
						{
							ExampleOptions = Model.Scenarios
								.Select(choice => new ApiSelectOption(choice.Title, choice.TabId, choice.TabId == scenario.TabId))
								.ToArray()
						}
						: scenario with { CodeSamplesOutsidePanel = true, ExampleOptions = [] };
					<div class="api-examples-scenario-panel api-examples-body" data-scenario="@scenario.TabId" hidden="@(i == 0 ? null : "hidden")">
						@(await RenderPartialAsync<_ExampleScenarioContent, ExampleScenario>(rendered))
					</div>
				}
			</div>
		}
	</nav>
</aside>
