@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<OperationExamplesPanelModel>
@* ≥1024px: right rail (api-docs.css). Below that: in-flow column under the article.
   The title list stays above the scrolling samples so a second example is visible immediately. *@
<aside id="api-examples-panel" class="api-examples-panel shrink-0 w-full">
	@if (Model.Scenarios.Count > 1)
	{
		<nav class="api-examples-index" aria-label="Examples">
			<p class="api-examples-index-label">Examples</p>
			<ol class="api-examples-index-list">
				@foreach (var scenario in Model.Scenarios)
				{
					<li><a href="#api-example-@scenario.TabId">@scenario.Title</a></li>
				}
			</ol>
		</nav>
	}
	<div class="api-examples-panel-nav markdown-content simple-scrollbar">
		@foreach (var scenario in Model.Scenarios)
		{
			<section id="api-example-@scenario.TabId" class="api-examples-scenario-panel api-examples-body" data-scenario="@scenario.TabId">
				@if (Model.Scenarios.Count > 1)
				{
					<h3 class="api-examples-scenario-title">@scenario.Title</h3>
				}
				@(await RenderPartialAsync<_ExampleScenarioContent, ExampleScenario>(scenario))
			</section>
		}
	</div>
</aside>
