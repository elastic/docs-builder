@inherits RazorSlice<ApiCodeSampleModel>
@{
	var selectId = $"{Model.IdPrefix}-lang";
}
<div class="api-code-card api-code-sample" data-api-code-sample>
	<div class="api-code-sample-header">
		<div class="api-code-sample-title">
			@if (!string.IsNullOrEmpty(Model.HttpMethod))
			{
				@(await RenderPartialAsync<_HttpMethodBadge, string>(Model.HttpMethod))
			}
			@if (!string.IsNullOrEmpty(Model.Route))
			{
				<span class="api-url">@Model.Route</span>
			}
		</div>
		<div class="api-code-sample-actions">
			@if (Model.Examples is { Count: > 1 })
			{
				@(await RenderPartialAsync<_ApiSelect, ApiSelectModel>(new ApiSelectModel
				{
					AriaLabel = "Example",
					Options = Model.Examples,
					ExtraClass = "api-scenario-select"
				}))
			}
			@if (Model.Samples.Count > 1)
			{
				@(await RenderPartialAsync<_ApiSelect, ApiSelectModel>(new ApiSelectModel
				{
					AriaLabel = "Language",
					Options = [.. Model.Samples.Select((sample, i) => new ApiSelectOption(sample.Language, sample.Language, i == 0))],
					ExtraClass = "api-code-sample-lang",
					Id = selectId,
					SyncGroup = "api-language"
				}))
			}
		</div>
	</div>
	<div class="api-code-sample-body">
		@for (var i = 0; i < Model.Samples.Count; i++)
		{
			var sample = Model.Samples[i];
			<div class="api-code-sample-panel" data-lang="@sample.Language" hidden="@(i == 0 ? null : "hidden")">
				@(await RenderPartialAsync<_ApiCodeBlock, ApiCodeBlockModel>(new ApiCodeBlockModel(sample.HighlightClass, sample.Source)))
			</div>
		}
	</div>
</div>
