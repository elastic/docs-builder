@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.SectionHeader>
<h4 class="section-header" id="@Model.Anchor" data-section="@Model.Anchor">
	<a class="headerlink" href="#@Model.Anchor">@Model.Title</a>
	@if (!string.IsNullOrEmpty(Model.ContentTypeBadge))
	{
		<span class="content-type-badge">@Model.ContentTypeBadge</span>
	}
</h4>
