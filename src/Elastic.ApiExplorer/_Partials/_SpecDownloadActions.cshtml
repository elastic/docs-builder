@inherits RazorSlice<Elastic.Documentation.Site.ApiSpecDownload>
@* For a page with no Markdown export, so no Copy page: the spec download is the whole menu. Like Copy page's, the menu
   is a popover placed beside its button by floating.ts. Without popover support the links show inline (api-docs.css). *@
<div class="api-page-actions api-page-actions--download-only" role="group" aria-label="Page actions">
	<div class="api-page-actions-split">
		<button type="button" class="api-page-actions-chevron api-page-actions-chevron--labeled" popovertarget="api-page-actions-menu" aria-haspopup="menu" aria-expanded="false">
			@await RenderPartialAsync(_DownloadIcon.Create())
			<span class="api-page-actions-label">Download spec</span>
		</button>
	</div>
	<div id="api-page-actions-menu" class="api-page-actions-menu" role="menu" popover data-placement="bottom-end" data-boundary=".api-page-toolbar">
		@await RenderPartialAsync(_SpecDownloadLinks.Create(Model))
	</div>
</div>
