@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.ApiBreadcrumbsView>
@{
	var items = Model.Trail.Items;
	if (items.Count == 0)
		return;

	var last = items.Count - 1;
}
<nav class="api-breadcrumbs" aria-label="Breadcrumb" data-api-breadcrumbs>
	<ol>
		@for (var i = 0; i < items.Count; i++)
		{
			var crumb = items[i];
			var isFirst = i == 0;
			var isLast = i == last;
			var middleIndex = isFirst || isLast ? (int?)null : i - 1;
			@if (isLast && items.Count > 2)
			{
				<li class="api-breadcrumbs__overflow" hidden>
					<details class="api-breadcrumbs__overflow-dropdown">
						<summary aria-label="More breadcrumbs" aria-haspopup="menu">
							<span aria-hidden="true">…</span>
						</summary>
						<div class="api-page-actions-menu" role="menu">
							@for (var m = 1; m < last; m++)
							{
								var hidden = items[m];
								if (hidden.Url is not null)
								{
									<a class="api-page-actions-option"
									   role="menuitem"
									   hidden
									   data-overflow-index="@(m - 1)"
									   href="@hidden.Url"
									   @Model.HxAttributes>@hidden.Title</a>
								}
								else
								{
									<span class="api-page-actions-option"
									      hidden
									      data-overflow-index="@(m - 1)">@hidden.Title</span>
								}
							}
						</div>
					</details>
				</li>
				<li class="api-breadcrumbs__sep" aria-hidden="true" data-overflow-sep hidden>/</li>
			}
			<li @CrumbAttributes(isFirst, isLast, middleIndex)>
				@if (crumb.IsCurrent)
				{
					<span class="api-breadcrumbs__current" aria-current="page">@crumb.Title</span>
				}
				else
				{
					<a href="@crumb.Url" @Model.HxAttributes>@crumb.Title</a>
				}
			</li>
			@if (!isLast)
			{
				<li @SepAttributes(isFirst, middleIndex) aria-hidden="true">/</li>
			}
		}
	</ol>
</nav>
@functions {
	private static HtmlString CrumbAttributes(bool isFirst, bool isLast, int? middleIndex)
	{
		var role = isFirst ? "start" : isLast ? "end" : "middle";
		return middleIndex is { } index
			? new HtmlString($"class=\"api-breadcrumbs__item\" data-crumb=\"{role}\" data-crumb-index=\"{index}\"")
			: new HtmlString($"class=\"api-breadcrumbs__item\" data-crumb=\"{role}\"");
	}

	private static HtmlString SepAttributes(bool isFirst, int? middleIndex)
	{
		if (middleIndex is { } index)
			return new HtmlString($"class=\"api-breadcrumbs__sep\" data-sep-for=\"{index}\"");
		return isFirst
			? new HtmlString("class=\"api-breadcrumbs__sep\" data-sep=\"after-start\"")
			: new HtmlString("class=\"api-breadcrumbs__sep\"");
	}
}
