@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.TitleBadgesModel>
@if (Model.Any)
{
	<span class="api-title-badges">
		@if (Model.AuthText is { } authText)
		{
			if (Model.AuthHref is { } authHref)
			{
				<a class="api-badge" href="@authHref">@authText</a>
			}
			else
			{
				<span class="api-badge">@authText</span>
			}
		}
		@if (Model.Availability is { } availability)
		{
			<span class="applies applies-inline">@await RenderPartialAsync(ApplicableToComponent.Create(availability))</span>
		}
		@if (Model.Deprecated)
		{
			<span class="api-badge api-badge--danger">Deprecated</span>
		}
	</span>
}
