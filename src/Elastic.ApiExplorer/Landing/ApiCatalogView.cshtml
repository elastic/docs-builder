@inherits RazorSlice<Elastic.ApiExplorer.Landing.ApiCatalogViewModel>
@implements IUsesLayout<Elastic.ApiExplorer._Layout, Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@functions {
	public ApiLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();
}
<section id="elastic-docs-v3">
	<h1>API Explorer</h1>
	<ul>
		@foreach (var entry in Model.Entries.OrderBy(e => e.Key))
		{
			<li><a href="@entry.Url">@entry.Title</a> (<code>@entry.Key</code>)</li>
		}
	</ul>
</section>
