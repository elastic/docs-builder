@inherits RazorSlice<Elastic.ApiExplorer.Landing.TagLandingViewModel>
@using Elastic.ApiExplorer.Landing
@implements IUsesLayout<Elastic.ApiExplorer._Layout, ApiLayoutViewModel>
@functions {
	public ApiLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();

	// The external docs link sits in the right rail, under Copy page.
	protected override async Task ExecuteSectionAsync(string name)
	{
		if (name != ApiPageSections.Rail || Model.ExternalDocsDisplay is not { } ed)
			return;
		<dl class="api-rail-facts">
			<div class="api-rail-fact">
				<dt>Learn more</dt>
				<dd>
					<a href="@ed.Url" class="docs-reference-btn" target="@(ed.IsElasticDocs ? null : "_blank")" rel="@(ed.IsElasticDocs ? null : "noopener noreferrer")">@ed.LinkText</a>
				</dd>
			</div>
		</dl>
	}
}
<section id="elastic-api-v3" class="api-group">
	<div class="api-page-heading">
		<h1>@Model.Tag.DisplayName</h1>
	</div>
	@if (!string.IsNullOrEmpty(Model.DescriptionMarkdown))
	{
		<div class="api-tag-description docs-measure">@Model.RenderMarkdown(Model.DescriptionMarkdown)</div>
	}
	@foreach (var extra in Model.PostSections)
	{
		<h3 id="@extra.Anchor">@extra.Heading</h3>
		<div>@extra.BodyHtml</div>
	}
	@if (Model.OverviewRows.Count > 0)
	{
		<div class="api-overview">
			@(await RenderPartialAsync<_ApiGroupList, ApiGroupListModel>(new ApiGroupListModel(Model.OverviewRows, LayoutModel.HxAttributes)))
		</div>
	}
</section>
