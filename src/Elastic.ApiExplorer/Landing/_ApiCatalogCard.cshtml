@inherits RazorSlice<Elastic.ApiExplorer.Landing.ApiCatalogCard>
@using System.Text.RegularExpressions
@{
	var item = Model.Item;
	var titleId = "api-catalog-title-" + Regex.Replace(item.Key, "[^a-zA-Z0-9_-]", "-");
	var compact = Model.Kind == ApiCatalogCardKind.Compact;
	// The classes are the ones on the cards of the elastic.co/docs landing page ("Solutions and use cases"): the
	// icon, top-aligned, beside one column holding a bold text-xl title and a mt-2 description. The compact card is a
	// smaller version of it.
	var box = compact ? "gap-3 px-4 py-3" : "gap-4 p-6";
	var icon = compact ? "size-5" : "size-8";
	var title = compact ? "text-sm" : "text-xl";
	var desc = compact ? "mt-0.5 text-xs" : "mt-2";
	var kind = compact ? "api-catalog-card-compact" : "";
	if (Model.HasVariant)
		kind += " api-catalog-card-parent";
	if (Model.Column is not null)
		kind += " api-catalog-card-attached";
}
<li class="m-0 list-none@(Model.Column is null ? "" : " api-catalog-cell")" style="@(Model.Column is { } column ? $"--api-catalog-column: {column}" : null)">
	@* The card is the link. Nothing inside it is interactive, so there is no overlay to get trapped in a positioned
	   ancestor, and the whole box is one target, one hover area and one focus ring. aria-labelledby keeps the
	   announced name to the title instead of reading the whole card as the link text. *@
	<a href="@item.Url" aria-labelledby="@titleId" class="api-card api-catalog-card @kind flex h-full items-start @box">
		<span class="api-catalog-card-icon @icon shrink-0" aria-hidden="true">@(new HtmlString(item.IconSvg))</span>
		<div class="flex min-w-0 grow flex-col self-stretch">
			<h3 id="@titleId" class="api-card-title api-catalog-card-title font-sans font-bold text-ink-dark @title">@item.Title</h3>
			@if (!string.IsNullOrWhiteSpace(item.Summary))
			{
				<p class="api-catalog-desc @desc">@item.Summary</p>
			}
			@if (item.Deployments.Count > 0 && Model.Kind == ApiCatalogCardKind.Standard)
			{
				@* Name-only tags: the catalog knows the deployment, not a lifecycle or version. They sit at the bottom so the
				   tags line up across a row. Only the full-size card has them: the cards of a group would repeat the same
				   few tags on every card. *@
				<div class="mt-auto flex flex-wrap gap-1.5 pt-2">
					@foreach (var deployment in item.Deployments)
					{
						<span class="api-catalog-tag" data-tippy-content="@(deployment.Label == deployment.Name ? "" : deployment.Name)">@deployment.Label</span>
					}
				</div>
			}
		</div>
	</a>
</li>
