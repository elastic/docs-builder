@inherits RazorSlice<Elastic.ApiExplorer.Landing.LandingViewModel>
@using Elastic.ApiExplorer.Operations
@using Elastic.ApiExplorer.Landing;
@implements IUsesLayout<Elastic.ApiExplorer._Layout, Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@functions {
	public ApiLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();
}
@{
	var apiHxAttrs = LayoutModel.HxAttributes;
}
<section id="elastic-docs-v3">
	<div class="api-landing-heading api-page-heading">
		@if (Model.IconSvg is not null)
		{
			<span class="api-landing-icon">@(new HtmlString(Model.IconSvg))</span>
		}
		<h1>@Model.ApiInfo.Title</h1>
		@(await RenderPartialAsync<_PageActions, string>(LayoutModel.MarkdownUrl))
	</div>
	<p>@Model.RenderMarkdown(Model.ApiInfo.Description)</p>
	<p>License: @Model.ApiInfo.License?.Name</p>
	@if (LayoutModel.BuildType != BuildType.Assembler)
	{
		<p>Download source: <a href="@Model.JsonUrl" download>JSON</a> <a href="@Model.YamlUrl" download>YAML</a></p>
	}
	<div class="api-overview">
		@foreach (var section in Model.OverviewSections)
		{
			if (section.Heading is { } heading)
			{
				if (heading.Kind == OverviewRowKind.ClassificationHeading)
				{
					<h2>@heading.Title</h2>
				}
				else if (heading.Url is not null)
				{
					<h3><a href="@heading.Url" @apiHxAttrs>@heading.Title</a></h3>
				}
				else
				{
					<h3>@heading.Title</h3>
				}
			}
			if (section.Items.Count > 0)
			{
				<ul class="api-group-list">
					@foreach (var row in section.Items)
					{
						@(await RenderPartialAsync<_ApiGroupRow, ApiGroupRowModel>(new ApiGroupRowModel(row, apiHxAttrs)))
					}
				</ul>
			}
		}
	</div>
</section>
