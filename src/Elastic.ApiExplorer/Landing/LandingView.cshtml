@inherits RazorSlice<Elastic.ApiExplorer.Landing.LandingViewModel>
@using Elastic.ApiExplorer.Operations
@using Elastic.ApiExplorer.Landing;
@implements IUsesLayout<Elastic.ApiExplorer._Layout, Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@functions {
	public ApiLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();

	// What you need to call the API (server URLs, spec download) sits in the right rail, under Copy page.
	// Below 1024px the rail drops under the whole catalog, so the same facts also sit under the intro (hidden on wide screens).
	protected override async Task ExecuteSectionAsync(string name)
	{
		if (name != ApiPageSections.Rail)
			return;
		@await RenderPartialAsync(_LandingFacts.Create(new LandingFactsModel(Model, "rail")))
	}
}
@{
	var apiHxAttrs = LayoutModel.HxAttributes;
}
<section id="elastic-docs-v3" class="api-landing">
	<div class="api-landing-heading api-page-heading">
		@if (Model.IconSvg is not null)
		{
			<span class="api-landing-icon">@(new HtmlString(Model.IconSvg))</span>
		}
		<h1>@Model.ApiInfo.Title</h1>
	</div>
	<div class="docs-measure">
		<p>@Model.DescriptionLead</p>
	</div>
	@if (Model.HasFacts)
	{
		@await RenderPartialAsync(_LandingFacts.Create(new LandingFactsModel(Model, "inline")))
	}
	@if (Model.DescriptionRemainder is { } remainder)
	{
		<div class="docs-measure">
			@remainder
		</div>
	}
	<div class="api-overview">
		<div class="api-index">
			@foreach (var group in Model.IndexSections)
			{
				if (group.Heading is { Kind: OverviewRowKind.ClassificationHeading } classification)
				{
					<h2 class="api-index-heading">@classification.Title</h2>
					continue;
				}
				@(await RenderPartialAsync<_ApiIndexGroup, ApiIndexGroupModel>(new ApiIndexGroupModel(group, apiHxAttrs)))
			}
		</div>
	</div>
</section>
