@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<ApiGroupRowModel>
<li>
	<a class="api-group-row@(Model.Row.Deprecated ? " api-group-row--deprecated" : "")" href="@Model.Row.Url" @(new HtmlString(Model.HxAttributes))>
		<span class="api-group-method">
			@if (Model.Row.PrimaryRoute is { } methodsRoute)
			{
				@(await RenderPartialAsync<_HttpMethodBadge, IReadOnlyList<string>>(methodsRoute.Methods))
			}
		</span>
		<span class="api-group-heading">
			<span class="api-overview-title">@if (Model.Row.Deprecated){<s class="api-deprecated-title">@Model.Row.Title</s>}else{@Model.Row.Title}</span>
			@await RenderPartialAsync(_TitleBadges.Create(new TitleBadgesModel(Model.Row.Availability, Model.Row.Deprecated, Model.Row.DesignSystem)))
		</span>
		<span class="api-group-routes">
			@if (Model.Row.PrimaryRoute is { } route)
			{
				@(await RenderPartialAsync<_GroupRoute, GroupRouteModel>(new GroupRouteModel(route)))
			}
			else if (Model.Row.Kind == OverviewRowKind.Schema)
			{
				<code class="api-group-route">@Model.Row.SchemaId</code>
			}
			else if (Model.Row.Kind != OverviewRowKind.Operation)
			{
				@:Additional documentation
			}
		</span>
		<svg class="api-group-chevron" viewBox="0 0 16 16" aria-hidden="true"><use href="#icon-chevron-down"/></svg>
	</a>
</li>
