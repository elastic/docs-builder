@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<ApiGroupRowModel>
@{
	var row = Model.Row;
	var route = row.Endpoint is { Rows.Count: > 0 } endpoint ? endpoint.Rows[0] : null;
}
<li>
	<a class="api-group-row@(row.Deprecated ? " api-group-row--deprecated" : "")" href="@row.Url" @(new HtmlString(Model.HxAttributes))>
		<span class="api-group-method">
			@if (route is not null)
			{
				@(await RenderPartialAsync<_HttpMethodBadge, IReadOnlyList<string>>(route.Methods))
			}
		</span>
		<span class="api-group-heading">
			<span class="api-overview-title">@if (row.Deprecated){<s class="api-deprecated-title">@row.Title</s>}else{@row.Title}</span>
			@await RenderPartialAsync(_TitleBadges.Create(new TitleBadgesModel(row.Availability, row.Deprecated, row.DesignSystem)))
		</span>
		<span class="api-group-routes">
			@if (route is not null)
			{
				@(await RenderPartialAsync<_GroupRoute, EndpointRow>(route))
			}
			else if (row.Kind == OverviewRowKind.Schema)
			{
				<code class="api-group-route">@row.SchemaId</code>
			}
			else if (row.Kind != OverviewRowKind.Operation)
			{
				@:Additional documentation
			}
		</span>
		<svg class="api-group-chevron" viewBox="0 0 16 16" aria-hidden="true"><use href="#icon-chevron-down"/></svg>
	</a>
</li>
