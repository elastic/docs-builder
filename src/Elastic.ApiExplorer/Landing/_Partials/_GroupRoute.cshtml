@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<EndpointRow>
@* The route of an overview row as plain text. A <wbr> before each slash lets a long route wrap between segments, not mid-word. Segments stay on the brace lines so Razor emits no whitespace between them. *@
<code class="api-group-route">@if (Model.Segments.Count == 0){@("/")}@foreach (var segment in Model.Segments){<wbr>@("/" + segment.Text)}</code>
