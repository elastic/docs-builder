@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<OperationUrlListModel>
@if (Model.Endpoint is { } endpoint)
{
		<ul class="api-url-listing">
		@foreach (var row in endpoint.Rows)
		{
			<li class="api-url-list-item">
				<span class="api-url-row">
					@(await RenderPartialAsync<_EndpointPath, EndpointPathModel>(new EndpointPathModel(row, endpoint.ShortestRoute)))
				</span>
			</li>
		}
		</ul>
}
