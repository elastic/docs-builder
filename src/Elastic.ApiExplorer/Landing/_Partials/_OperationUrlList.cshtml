@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<OperationUrlListModel>
@* Overview rows show the main path only; the operation page lists every path. *@
@if (Model.Endpoint is { Rows.Count: > 0 } endpoint)
{
		<ul class="api-url-listing">
			<li class="api-url-list-item">
				<span class="api-url-row">
					@(await RenderPartialAsync<_EndpointPath, EndpointPathModel>(new EndpointPathModel(endpoint.Rows[0], endpoint.ShortestRoute)))
				</span>
			</li>
		</ul>
}
