@inherits RazorSlice<ApiIndexGroupModel>
@* One endpoint group on the product landing page: its name, how many endpoints its page lists, and what it is for, which the sidebar does not say. *@
@{
	var heading = Model.Group.Heading;
	var count = Model.Group.Items.Count;
}
@if (heading is { Url: { } url })
{
	<a class="api-index-tile" href="@url" @(new HtmlString(Model.HxAttributes))>
		<span class="api-index-tile-title">@if (heading.Deprecated){<s class="api-deprecated-title">@heading.Title</s><span class="sr-only">Deprecated</span>}else{@heading.Title}</span>
		<span class="api-index-tile-count">@count @(count == 1 ? "endpoint" : "endpoints")</span>
		@if (heading.Summary is { } summary)
		{
			<span class="api-index-tile-summary">@summary</span>
		}
	</a>
}
