@inherits RazorSlice<ApiIndexGroupModel>
@* A group on the product landing page: its name, its endpoint count and what it is for, which the sidebar does not say. *@
<li>
	<a class="api-group-row api-index-row" href="@Model.Heading.Url" @(new HtmlString(Model.HxAttributes))>
		<span class="api-group-heading">
			<span class="api-overview-title">@if (Model.Heading.Deprecated){<s class="api-deprecated-title">@Model.Heading.Title</s><span class="sr-only">Deprecated</span>}else{@Model.Heading.Title}</span>
			<span class="api-index-row-count">@Model.EndpointsLabel</span>
		</span>
		@if (Model.Heading.Summary is { } summary)
		{
			<span class="api-index-row-summary">@summary</span>
		}
		<svg class="api-group-chevron" viewBox="0 0 16 16" aria-hidden="true"><use href="#icon-chevron-down"/></svg>
	</a>
</li>
