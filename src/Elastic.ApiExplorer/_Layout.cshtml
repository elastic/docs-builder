@inherits RazorLayoutSlice<Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@implements IUsesLayout<Elastic.Documentation.Site._GlobalLayout, GlobalLayoutViewModel>
@functions {
	public GlobalLayoutViewModel LayoutModel => Model;
	protected override Task ExecuteSectionAsync(string name)
	{
		if (name == GlobalSections.Head)
		{
			<link rel="alternate" type="text/markdown" href="@(Model.MarkdownUrl)" title="Markdown export"/>
			@if (!string.IsNullOrEmpty(Model.ProductName))
			{
				<meta class="elastic" name="product_name" content="@Model.ProductName"/>
				<meta name="DC.subject" content="@Model.ProductName"/>
			}
		}
		return Task.CompletedTask;
	}
}
@if (Model.Features.NavigationPreviewEnabled)
{
	if (Model.BuildType == BuildType.Assembler)
	{
		@await RenderPartialAsync(_DesignSystemAssemblerHeader.Create(Model))
	}
	else
	{
		@await RenderPartialAsync(_DesignSystemHeader.Create(Model))
	}
	<div id="main-container">
		<div class="layout layout--two layout--nav-flush api-page-shell">
			<input class="layout__drawer-toggle" type="checkbox" id="pages-nav-hamburger">
			<label class="layout__scrim" for="pages-nav-hamburger" aria-hidden="true"></label>
			<aside class="layout__nav" id="pages-nav">
				@await RenderPartialAsync(_DesignSystemApiNav.Create(Model))
			</aside>
			<div class="layout__main" id="api-content-grid">
				<main id="content-container" class="layout__content">
					<label class="layout__menu-button" for="pages-nav-hamburger">
						@await RenderPartialAsync(Elastic.Documentation.Site.Components.Primitives.Icon._Icon.Create(new Elastic.Documentation.Site.Components.Primitives.Icon.IconModel { Name = "menu", Size = Elastic.Documentation.Site.Components.Primitives.Icon.IconSize.Small }))
						<span>Menu</span>
					</label>
					<div class="api-page-toolbar">
						@await RenderPartialAsync(_DesignSystemApiBreadcrumbs.Create(Model))
					</div>
					<article id="markdown-content" class="prose content-container markdown-content">
						@await RenderBodyAsync()
					</article>
					@await RenderPartialAsync(_DesignSystemPageFeedback.Create(Model))
				</main>
				<aside class="api-page-rail">
					@await RenderSectionAsync(ApiPageSections.Rail)
				</aside>
			</div>
		</div>
	</div>
	@await RenderPartialAsync(_DesignSystemFooter.Create(Model))
	return;
}
@if (Model.BuildType == BuildType.Assembler)
{
	@(await RenderPartialAsync(_AssemblerHeader.Create(Model)))
}
else
{
	@(await RenderPartialAsync(_IsolatedHeader.Create(Model)))
}
@* API content column. Sidebar is _ApiPagesNav (main), not Nav V2 _PagesNav. *@
<div id="main-container" class="relative">
	@if (Model.BuildType == BuildType.Assembler && Model.ApiContext is not null)
	{
		@(await RenderPartialAsync(_ApiContextBar.Create(Model.ApiContext)))
	}
	<div class="min-h-screen w-full mx-auto api-page-shell">
		<div class="min-h-screen grid grid-cols-1 md:grid-cols-[var(--max-sidebar-width)_1fr] gap-4">
			@* #api-content-grid is the htmx swap target for API pages (pages-nav.ts). Every API page has the same
			   two columns inside it: the article and the right rail (.api-page-grid in api-docs.css). The rail holds
			   Copy page, then whatever the page puts in ApiPageSections.Rail. *@
			@* Placed explicitly: the nav follows in the document, so while a large page is still
			   streaming the content must not fall into the nav's column. *@
			<div id="api-content-grid" class="min-w-0 md:col-start-2 md:row-start-1 mx-4 md:mx-0">
				<div class="api-page-grid">
					<main id="content-container" class="api-page-main relative pt-6 pb-12">
						<input type="checkbox" class="hidden" id="pages-nav-hamburger">
						@await RenderPartialAsync(_ApiPagesNavToggle.Create())
						<div class="api-page-toolbar">
							@* Isolated docs hide a one-item trail. The spec landing's only crumb is the catalog. *@
							@(await RenderPartialAsync(_Breadcrumbs.Create(new BreadcrumbsView(Model.Breadcrumbs, Model.BuildType, ShowSingle: true))))
						</div>
						<article id="markdown-content" class="content-container markdown-content">
							@await RenderBodyAsync()
						</article>
						@await RenderPartialAsync(_PageFeedback.Create(Model))
					</main>
					<div class="api-page-rail">
						@if (Model.ShowPageActions)
						{
							@(await RenderPartialAsync<_PageActions, string>(Model.MarkdownUrl))
						}
						@await RenderSectionAsync(ApiPageSections.Rail)
					</div>
				</div>
			</div>
			@await RenderPartialAsync(_ApiPagesNav.Create(Model))
		</div>
	</div>
</div>
@if (Model.BuildType == BuildType.Assembler)
{
	@(await RenderPartialAsync(_AssemblerFooter.Create(Model)))
}
else
{
	@(await RenderPartialAsync(_IsolatedFooter.Create(Model)))
}
