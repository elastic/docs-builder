@inherits RazorLayoutSlice<Elastic.ApiExplorer.Infrastructure.ApiLayoutViewModel>
@using Elastic.ApiExplorer.Landing
@implements IUsesLayout<Elastic.Documentation.Site._GlobalLayout, GlobalLayoutViewModel>
@functions {
	public GlobalLayoutViewModel LayoutModel => Model;
	protected override Task ExecuteSectionAsync(string name)
	{
		if (name == GlobalSections.Head)
		{
			<link rel="alternate" type="text/markdown" href="@(Model.MarkdownUrl)" title="Markdown export"/>
		}
		return Task.CompletedTask;
	}
}
@if (Model.BuildType == BuildType.Assembler)
{
	@(await RenderPartialAsync(_AssemblerHeader.Create(Model)))
}
else
{
	@(await RenderPartialAsync(_IsolatedHeader.Create(Model)))
}
@* min-h-screen, like the API product layout: a short page still fills the screen, so the footer sits below the fold instead of under the cards. *@
<div id="main-container" class="flex min-h-screen flex-col items-center">
	@* The catalog's hero, outside the container below so a band behind it can span the screen. *@
	@await RenderSectionAsync(ApiCatalog.HeroSection)
	<div class="max-w-(--max-layout-width) w-full px-6">
		<main id="content-container" class="w-full pb-12">
			<div class="api-page-toolbar">
				@(await RenderPartialAsync(_Breadcrumbs.Create(new BreadcrumbsView(Model.Breadcrumbs, Model.BuildType, ShowSingle: true))))
			</div>
			@await RenderBodyAsync()
		</main>
	</div>
</div>
@if (Model.BuildType == BuildType.Assembler)
{
	@(await RenderPartialAsync(_AssemblerFooter.Create(Model)))
}
else
{
	@(await RenderPartialAsync(_IsolatedFooter.Create(Model)))
}
