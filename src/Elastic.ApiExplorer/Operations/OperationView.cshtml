@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.OperationViewModel>
@implements IUsesLayout<Elastic.ApiExplorer._Layout, ApiLayoutViewModel>
@functions {
	public ApiLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();
}
@{
	var operation = Model.Operation.Operation;
	var pageModel = Model.Page;
	var endpointListingAttrs = pageModel.HasMultipleOverloads
		? new HtmlString(" role=\"radiogroup\" aria-label=\"Endpoints\"")
		: HtmlString.Empty;
}

@* Intro spans both columns (title + paths); reference column starts below. *@
<header class="api-page-intro">
	<div class="api-page-heading">
		<h1>@operation.Summary</h1>
		@(await RenderPartialAsync<_PageActions, string>(LayoutModel.MarkdownUrl))
	</div>
	@if (operation.Deprecated || pageModel.IsBeta)
	{
		<div class="api-title-badges">
			@if (operation.Deprecated)
			{
				<span class="deprecated-badge type-status">deprecated</span>
			}
			@if (pageModel.IsBeta)
			{
				<span class="beta-badge type-status">Beta</span>
			}
		</div>
	}
	@if (pageModel.Servers is { Count: > 0 })
	{
		<div class="server-info">
			<span class="server-label">Server@(pageModel.Servers.Count > 1 ? "s" : ""):</span>
			@foreach (var server in pageModel.Servers)
			{
				<span class="server-url">
					<code>@server.Url</code>
					@if (!string.IsNullOrEmpty(server.Description))
					{
						<span class="server-description">(@server.Description)</span>
					}
				</span>
			}
		</div>
	}

	<ul id="paths" class="api-url-listing@(pageModel.HasMultipleOverloads ? " api-url-listing--multi" : "")"@endpointListingAttrs>
		@foreach (var overload in pageModel.Overloads)
		{
			var method = overload.Model.OperationType.ToString().ToLowerInvariant();
			var isCurrent = overload.Model.Route == Model.Operation.Route && overload.Model.OperationType == Model.Operation.OperationType;
			<li class="api-url-list-item">
				<label class="api-url-row@(isCurrent ? " current" : "")">
					@if (pageModel.HasMultipleOverloads)
					{
						<input
							type="radio"
							class="api-url-radio"
							name="api-endpoint"
							value="@overload.Url"
							aria-label="@(method.ToUpperInvariant()) @overload.Model.Route"
							hx-get="@overload.Url"
							@LayoutModel.HxAttributes
							@(isCurrent ? "checked" : null) />
					}
					@(await RenderPartialAsync<_HttpMethodBadge, string>(method))
					<span class="api-url">@overload.Model.Route</span>
					@(await RenderPartialAsync<_EndpointCopyButton, string>(overload.Model.Route))
				</label>
			</li>
		}
	</ul>
</header>
<section id="elastic-api-v3" class="api-page-reference">
	@{
		var prerequisites = Model.Prerequisites;
	}
	@if (!string.IsNullOrWhiteSpace(pageModel.DescriptionMarkdown) || pageModel.DescriptionUrls.Count > 0)
	{
		<div class="api-operation-description" id="description">
			@if (pageModel.DescriptionUrls.Count > 0)
			{
				<p class="api-description-url-label">@ApiMarkdown.OperationListLabel</p>
				<ul class="api-url-listing api-description-url-listing">
					@foreach (var url in pageModel.DescriptionUrls)
					{
						<li class="api-url-list-item">
							<span class="api-url-row">
								@(await RenderPartialAsync<_HttpMethodBadge, string>(url.Method))
								<span class="api-url">@url.Route</span>
							</span>
						</li>
					}
				</ul>
			}
			@if (!string.IsNullOrWhiteSpace(pageModel.DescriptionMarkdown))
			{
				@(Model.RenderMarkdown(pageModel.DescriptionMarkdown))
			}
			@if (pageModel.ExternalDocs is not null)
			{
				<a href="@pageModel.ExternalDocs.Url" class="docs-reference-btn" @(pageModel.ExternalDocs.IsElasticDocs ? "" : "target=\"_blank\" rel=\"noopener\"")>
					@pageModel.ExternalDocs.LinkText
				</a>
			}
		</div>
	}
	else if (pageModel.ExternalDocs is not null)
	{
		<a href="@pageModel.ExternalDocs.Url" class="docs-reference-btn" @(pageModel.ExternalDocs.IsElasticDocs ? "" : "target=\"_blank\" rel=\"noopener\"")>
			@pageModel.ExternalDocs.LinkText
		</a>
	}
	@if (prerequisites is { Count: > 0 })
	{
		var collapsePrereq = ParamSectionHeader.ShouldCollapse(prerequisites.Count);
		<div @ParamSectionHeader.WrapAttributes(collapsePrereq)>
		@if (collapsePrereq)
		{
			@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Prerequisites", "prerequisites", Model.PrerequisiteNames)))
		}
		else
		{
			@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Prerequisites", "prerequisites")))
		}
		<div @ParamSectionHeader.BodyAttributes(collapsePrereq, "prerequisites-list")>
		<dl class="property-list">
		@foreach (var row in prerequisites)
		{
			<div class="prerequisite-item">
				<dt>
					@if (row.Badge is not null)
					{
						<code>@row.Label</code>
						<span class="api-type-badge">@row.Badge</span>
					}
					else
					{
						@Model.RenderMarkdown(row.Label)
					}
				</dt>
			</div>
		}
		</dl>
		</div>
		</div>
	}
	@if (pageModel.AuthSchemes.Count > 0)
	{
		var collapseAuth = ParamSectionHeader.ShouldCollapse(pageModel.AuthSchemes.Count);
		<div @ParamSectionHeader.WrapAttributes(collapseAuth)>
		@if (collapseAuth)
		{
			@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Authorization", "authorization", pageModel.AuthSchemeNames)))
		}
		else
		{
			@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Authorization", "authorization")))
		}
		<div @ParamSectionHeader.BodyAttributes(collapseAuth, "authorization-list")>
		<dl class="property-list">
		@foreach (var scheme in pageModel.AuthSchemes)
		{
			<div class="auth-scheme-item">
				<dt>
					<code>@scheme.Label</code>
				</dt>
			</div>
		}
		</dl>
		</div>
		</div>
	}
	@if (pageModel.PathParameters.Count > 0)
	{
		var collapsePath = ParamSectionHeader.ShouldCollapse(pageModel.PathParameterNames.Count);
		<div @ParamSectionHeader.WrapAttributes(collapsePath)>
		@if (collapsePath)
		{
			@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Parameters", "parameters", pageModel.PathParameterNames)))
		}
		else
		{
			@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Parameters", "parameters")))
		}
		<div @ParamSectionHeader.BodyAttributes(collapsePath, "parameters-list")>
		<dl class="property-list">
		@foreach (var path in pageModel.PathParameters)
		{
			<div class="path-param @(path.Deprecated is true ? "deprecated" : "")">
				<dt id="path-@path.Name">
					<a class="property-anchor" href="#path-@path.Name">
						<span class="property-anchor-icon" aria-hidden="true"></span>
						<code>@path.Name</code>
					</a>
					@if (path.Required)
					{
						<span class="required type-status">required</span>
					}
					@if (path.Deprecated is true)
					{
						<span class="deprecated-badge type-status">deprecated</span>
					}
				</dt>
			<dd>@path.DescriptionHtml</dd>
		</div>
		}
		</dl>
		</div>
		</div>
	}

	@if (pageModel.QueryParameters.Count > 0)
	{
		var collapseQuery = ParamSectionHeader.ShouldCollapse(pageModel.QueryParameterNames.Count);
		<div @ParamSectionHeader.WrapAttributes(collapseQuery)>
		@if (collapseQuery)
		{
			@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Query Parameters", "query-params", pageModel.QueryParameterNames)))
		}
		else
		{
			@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Query Parameters", "query-params")))
		}
		<div @ParamSectionHeader.BodyAttributes(collapseQuery, "query-params-list")>
		<dl class="property-list">
			@foreach (var qp in pageModel.QueryParameters)
			{
				var qs = qp.Parameter;
				<div class="query-param @(qs.Deprecated == true ? "deprecated" : "")">
					<dt id="query-@qs.Name">
						<a class="property-anchor" href="#query-@qs.Name">
							<span class="property-anchor-icon" aria-hidden="true"></span>
							<code>@qs.Name</code>
						</a>
						@if (qp.Type is not null)
						{
							@(await RenderPartialAsync<_SchemaType, TypeAnnotation>(qp.Type))
						}
						@if (qs.Required)
						{
							<span class="required type-status">required</span>
						}
						@if (qs.Deprecated == true)
						{
							<span class="deprecated-badge type-status">deprecated</span>
						}
					</dt>
					<dd>@qp.DescriptionHtml</dd>
				@if (qp.UnionOptions.Count > 0 && qp.EnumValues.Count == 0)
				{
					<dd class="union-options">
						<span class="values-label">One of:</span>
						@for (var optIndex = 0; optIndex < qp.UnionOptions.Count; optIndex++)
						{
							var unionOpt = qp.UnionOptions[optIndex];
							if (optIndex > 0)
							{
								<span class="union-inline-separator">or</span>
							}
							<code class="@SchemaHelpers.UnionOptionClasses(unionOpt.IsTypeOption, unionOpt.Text)">@unionOpt.Text</code>
						}
					</dd>
				}
				@if (qp.EnumValues.Count > 0)
				{
					<dd class="enum-values">
						<span class="values-label">Values:</span>
						@foreach (var enumVal in qp.EnumValues)
						{
							<code class="enum-value">@enumVal</code>
						}
					</dd>
				}
				</div>
			}
		</dl>
		</div>
		</div>
	}
	@if (operation.RequestBody is not null)
	{
		var collapseRequest = ParamSectionHeader.ShouldCollapse(pageModel.RequestPropertyNames.Count);
		<div @ParamSectionHeader.WrapAttributes(collapseRequest)>
		@if (collapseRequest)
		{
			@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Request", "request-body", pageModel.RequestPropertyNames)))
		}
		else
		{
			@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Request", "request-body")))
		}
		<div @ParamSectionHeader.BodyAttributes(collapseRequest, "request-body-list")>
		@if (!string.IsNullOrEmpty(operation.RequestBody.Description))
		{
			<p>@Model.RenderMarkdown(operation.RequestBody.Description)</p>
		}

		@if (pageModel.RequestProperties is not null)
		{
			@(await RenderPartialAsync<_PropertyList, ApiPropertyList>(pageModel.RequestProperties))
		}
		else if (pageModel.RequestType is not null)
		{
			<p>Type: @(await RenderPartialAsync<_SchemaType, TypeAnnotation>(pageModel.RequestType))</p>
		}
		</div>
		</div>
	}

	@if (pageModel.Responses.Count > 0)
	{
		@(await RenderPartialAsync<_ResponsesBlock, ResponsesBlockModel>(new ResponsesBlockModel(pageModel.Responses, Model.RenderMarkdown)))
	}
	@foreach (var extra in pageModel.PostSections)
	{
		@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader(extra.Heading, extra.Anchor)))
		<div>@extra.BodyHtml</div>
	}
</section>
