@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.OperationViewModel>
@implements IUsesLayout<Elastic.ApiExplorer._Layout, ApiLayoutViewModel>
@functions {
	public ApiLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();

	// The Base URL and examples sit in the right rail, under Copy page.
	// Below 1024px the rail drops under the whole article, so the Base URL also sits in the header (hidden on wide screens).
	protected override async Task ExecuteSectionAsync(string name)
	{
		if (name != ApiPageSections.Rail)
			return;
		if (Model.Servers.Count > 0)
		{
			<dl class="api-rail-facts api-rail-facts--rail">
				@await RenderPartialAsync(_BaseUrlFact.Create(Model.Servers))
			</dl>
		}
		if (Model.ExamplesPanel is { } examplesPanel)
		{
			@await RenderPartialAsync(_OperationExamplesPanel.Create(examplesPanel))
		}
	}
}
@{
	var operation = Model.Operation.Operation;
	var pageModel = Model.Page;
	var endpoint = pageModel.Endpoint;
}

<header class="api-page-intro">
	<div class="api-page-heading">
		<h1>@operation.Summary</h1>
	</div>
	@if (pageModel.Availability is not null || operation.Deprecated)
	{
		<div class="api-title-badges">
			@if (pageModel.Availability is { } availability)
			{
				<span class="applies applies-inline">@await RenderPartialAsync(ApplicableToComponent.Create(availability))</span>
			}
			@if (operation.Deprecated)
			{
				<span class="deprecated-badge type-status">deprecated</span>
			}
		</div>
	}
	@if (Model.Servers.Count > 0)
	{
		<dl class="api-rail-facts api-rail-facts--inline">
			@await RenderPartialAsync(_BaseUrlFact.Create(Model.Servers))
		</dl>
	}

	@{
		var documentedPathParameters = pageModel.PathParameterNames.ToHashSet(StringComparer.Ordinal);
	}
	<ul id="paths" class="api-url-listing" aria-label="Paths">
		@foreach (var row in endpoint.Rows)
		{
			<li class="api-url-list-item">
				<span class="api-url-row">
					@(await RenderPartialAsync<_EndpointPath, EndpointPathModel>(new EndpointPathModel(row, endpoint.ShortestRoute, documentedPathParameters)))
					@(await RenderPartialAsync<_EndpointCopyButton, string>($"{row.Method.ToUpperInvariant()} {row.Route}"))
				</span>
			</li>
		}
	</ul>
</header>
<section id="elastic-api-v3">
	@if (!string.IsNullOrWhiteSpace(pageModel.DescriptionMarkdown) || pageModel.ExternalDocs is not null)
	{
		<div class="api-operation-description" id="description">
			@if (!string.IsNullOrWhiteSpace(pageModel.DescriptionMarkdown))
			{
				@(Model.RenderMarkdown(pageModel.DescriptionMarkdown))
			}
			@if (pageModel.ExternalDocs is not null)
			{
				<a href="@pageModel.ExternalDocs.Url" class="docs-reference-btn" target="@(pageModel.ExternalDocs.IsElasticDocs ? null : "_blank")" rel="@(pageModel.ExternalDocs.IsElasticDocs ? null : "noopener")">
					@pageModel.ExternalDocs.LinkText
				</a>
			}
		</div>
	}
	else if (pageModel.ExternalDocs is not null)
	{
		<a href="@pageModel.ExternalDocs.Url" class="docs-reference-btn" target="@(pageModel.ExternalDocs.IsElasticDocs ? null : "_blank")" rel="@(pageModel.ExternalDocs.IsElasticDocs ? null : "noopener")">
			@pageModel.ExternalDocs.LinkText
		</a>
	}
	@(await RenderPartialAsync<_AuthorizationSection, AuthorizationSectionModel>(Model.Authorization))
	@foreach (var section in pageModel.ParameterSections)
	{
		@(await RenderPartialAsync<_ParameterListSection, ParameterListSection>(section))
	}
	@if (operation.RequestBody is not null)
	{
		var requestContents = MediaContentsModel.ForRequest(pageModel.RequestContents);
		<div @ParamSectionHeader.WrapAttributes()>
		@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Request body", "request-body", pageModel.RequestPropertyNames, pageModel.RequestSummaryStyle)))
		<div @ParamSectionHeader.BodyAttributes("request-body-list")>
		@if (!string.IsNullOrEmpty(operation.RequestBody.Description))
		{
			<p>@Model.RenderMarkdown(operation.RequestBody.Description)</p>
		}

		@(await RenderPartialAsync<_MediaContents, MediaContentsModel>(requestContents))
		</div>
		</div>
	}

	@if (pageModel.Responses.Count > 0)
	{
		@(await RenderPartialAsync<_ResponsesBlock, ResponsesBlockModel>(new ResponsesBlockModel(pageModel.Responses, Model.RenderMarkdown)))
	}
	@foreach (var extra in pageModel.PostSections)
	{
		@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader(extra.Heading, extra.Anchor)))
		<div>@extra.BodyHtml</div>
	}
</section>
