@using Elastic.ApiExplorer.Components.PropertyTree
@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.AuthorizationSectionModel>
@{
	var schemes = Model.Schemes;
	var useChips = schemes.Count > 1;
	var menuId = "authorization-schemes-menu";
	string PanelId(AuthScheme scheme) => $"authorization-{scheme.Id.ToLowerInvariant()}";
}
<div class="api-list-block api-authorization">
	@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Authorization", "authorization")))
	@if (schemes.Count > 0)
	{
		<p class="api-authorization-lead">@(useChips ? "Send one of these credentials." : "Send this credential.")</p>
		@* Schemes are alternatives, like union variants: the same chips pick one (chip-row.ts, api-union-chips.ts). Keep this row in
		   step with the chip markup in Components/PropertyTree/_Partials/_UnionOptions.cshtml. The
		   others use hidden="until-found" so find-in-page still reaches them. *@
		<div class="union-variants-container@(useChips ? " union-variant-chips" : "")" id="authorization-schemes">
			@if (useChips)
			{
				<div class="api-example-chips-row union-chips-row" data-chip-row>
					<div class="api-example-chips" role="tablist" aria-label="Credentials">
						@for (var i = 0; i < schemes.Count; i++)
						{
							<button type="button" role="tab" class="api-example-chip@(i == 0 ? " is-active" : "")" data-chip="@PanelId(schemes[i])" aria-controls="@PanelId(schemes[i])" aria-selected="@(i == 0 ? "true" : "false")">
								<span class="api-example-chip-title" data-chip-title>@schemes[i].Label</span>
							</button>
						}
					</div>
					<button type="button" class="api-example-more" data-chip-more aria-haspopup="menu" aria-expanded="false" aria-controls="@menuId" popovertarget="@menuId" hidden>
						<span data-chip-more-label></span>
						<svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><use href="#icon-chevron-down"/></svg>
					</button>
					<div id="@menuId" class="api-example-menu simple-scrollbar" popover="auto" data-chip-menu>
						<div role="menu" aria-label="More credentials">
							@foreach (var scheme in schemes)
							{
								<button type="button" role="menuitem" class="api-example-menu-item" data-chip="@PanelId(scheme)" hidden>
									<span class="api-example-menu-item-title" data-chip-item-title>@scheme.Label</span>
								</button>
							}
						</div>
					</div>
				</div>
			}
			<div class="union-variants">
				@for (var i = 0; i < schemes.Count; i++)
				{
					var scheme = schemes[i];
					<div class="union-variant-item api-authorization-panel" id="@PanelId(scheme)" hidden="@(useChips && i > 0 ? "until-found" : null)">
						@if (!string.IsNullOrEmpty(scheme.CredentialExample))
						{
							@(await RenderPartialAsync<_ApiCodeBlock, ApiCodeBlockModel>(new ApiCodeBlockModel("language-http", scheme.CredentialExample)))
						}
						@if (scheme.DescriptionMarkdown is not null)
						{
							<div class="api-authorization-description">@Model.RenderMarkdown(scheme.DescriptionMarkdown)</div>
						}
					</div>
				}
			</div>
		</div>
	}
	@if (Model.Privileges.Count > 0)
	{
		<h3 class="privileges-heading">Required privileges</h3>
		<dl class="property-list">
			@foreach (var row in Model.Privileges)
			{
				<div class="prerequisite-item">
					<dt>
						@if (row.Values.Count == 0)
						{
							@Model.RenderMarkdown(row.Label)
						}
						else
						{
							<code>@row.Label</code>
							@for (var i = 0; i < row.Values.Count; i++)
							{
								if (i > 0 && row.Join is not null)
								{
									<span class="privilege-join">@row.Join</span>
								}
								<span class="api-type-badge">@row.Values[i]</span>
							}
						}
					</dt>
				</div>
			}
		</dl>
	}
</div>
