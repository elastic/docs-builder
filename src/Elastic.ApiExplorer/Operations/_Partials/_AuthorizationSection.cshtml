@using Elastic.ApiExplorer.Components.PropertyTree
@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.AuthorizationSectionModel>
@{
	// The privileges stay visible; the credentials fold away, since a reader who is already set up does not need them.
	var requirements = Model.Requirements;
	var useTabs = requirements.Count > 1;
}
@if (Model.Privileges.Count > 0)
{
	<div class="api-list-block">
		@(await RenderPartialAsync<_SectionHeader, SectionHeader>(new SectionHeader("Required authorization", "required-authorization")))
		<dl class="property-list api-privileges">
			@foreach (var row in Model.Privileges)
			{
				<div class="prerequisite-item">
					<dt>
						@if (row.Values.Count == 0)
						{
							@Model.RenderMarkdown(row.Label)
						}
						else
						{
							<span class="privilege-label">@row.Label</span>
							@for (var i = 0; i < row.Values.Count; i++)
							{
								if (i > 0 && row.Join is not null)
								{
									<span class="privilege-join">@row.Join</span>
								}
								<span class="api-type-badge">@row.Values[i]</span>
							}
						}
					</dt>
				</div>
			}
		</dl>
	</div>
}
@if (requirements.Count > 0)
{
	<div @ParamSectionHeader.WrapAttributes()>
		@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Authentication", "authentication", [.. requirements.Select(static r => r.Label)], NamesAreVariants: true)))
		<div @ParamSectionHeader.BodyAttributes("authentication-list")>
			@* Each requirement is an alternative, so several of them become tabs: the same radio-button tabs as the docs. Switching needs no script; tabs.ts makes the other panels findable.
			   The schemes inside one requirement are sent together, so they share a panel. *@
			<div class="@(useTabs ? "api-tabs api-authentication-tabs" : null)">
				@for (var i = 0; i < requirements.Count; i++)
				{
					var requirement = requirements[i];
					var tabId = $"authentication-tab-{i}";
					@if (useTabs)
					{
						<input class="tabs-input" id="@tabId" name="authentication-tabs" type="radio" checked="@(i == 0 ? "checked" : null)" tabindex="0">
						<label class="tabs-label" for="@tabId">@requirement.Label</label>
					}
					<div class="@(useTabs ? "tabs-content " : "")api-authorization-panel">
						@if (requirement.Schemes.Count > 1)
						{
							<p>Send all of these together.</p>
						}
						@foreach (var scheme in requirement.Schemes)
						{
							@if (requirement.Schemes.Count > 1)
							{
								<h3>@scheme.Label</h3>
							}
							@if (!string.IsNullOrEmpty(scheme.CredentialExample))
							{
								@(await RenderPartialAsync<_ApiCodeBlock, ApiCodeBlockModel>(new ApiCodeBlockModel("language-http", scheme.CredentialExample)))
							}
							@if (scheme.DescriptionMarkdown is not null)
							{
								@Model.RenderMarkdown(scheme.DescriptionMarkdown)
							}
							@* OAuth 2.0 and OpenID Connect have no credential example, and a description is optional. The open section must still name the scheme. *@
							@if (string.IsNullOrEmpty(scheme.CredentialExample) && scheme.DescriptionMarkdown is null && requirement.Schemes.Count == 1)
							{
								<p>Uses @scheme.Label authentication.</p>
							}
						}
					</div>
				}
			</div>
		</div>
	</div>
}
