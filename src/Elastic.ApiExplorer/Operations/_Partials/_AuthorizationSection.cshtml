@using Elastic.ApiExplorer.Components.PropertyTree
@using Elastic.ApiExplorer.Infrastructure
@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.AuthorizationSectionModel>
@{
	// Both sections fold away like every other section: a reader who is already set up does not need them.
}
@if (Model.Privileges.Count > 0)
{
	<div @ParamSectionHeader.WrapAttributes()>
		@(await RenderPartialAsync<_ParamSectionHeader, ParamSectionHeader>(new ParamSectionHeader("Required authorization", "required-authorization", Model.PrivilegeNames, Model.PrivilegeStyle)))
		<div @ParamSectionHeader.BodyAttributes("required-authorization-list")>
			<dl class="property-list api-privileges">
				@foreach (var row in Model.Privileges)
				{
					<div class="prerequisite-item">
						<dt>
							@if (row.Values.Count == 0)
							{
								@Model.RenderMarkdown(row.Label)
							}
							else
							{
								<span class="privilege-label">@row.Label</span>
								@for (var i = 0; i < row.Values.Count; i++)
								{
									if (i > 0 && row.Join is not null)
									{
										<span class="privilege-join">@row.Join</span>
									}
									<span class="api-type-badge">@row.Values[i]</span>
								}
							}
						</dt>
					</div>
				}
			</dl>
		</div>
	</div>
}
@(await RenderPartialAsync<_AuthenticationSection, AuthenticationSectionModel>(new AuthenticationSectionModel(Model.Requirements, Model.AuthenticationOptional, Model.RenderMarkdown)))
