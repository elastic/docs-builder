@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.ParamSectionHeader>
@{
	// A union body reads as alternatives (A | B) and says what is folded away; fields read as an object ({ a, b }).
	var variants = Model.NamesAreVariants;
}
<span class="api-param-summary@(variants ? " is-variants" : "")" data-param-summary @(variants ? new HtmlString("data-param-more-noun=\"variant\"") : HtmlString.Empty)>
	@if (!variants)
	{
		<span class="api-param-summary-brace">{ </span>
	}
	<span class="api-param-summary-list">
		@foreach (var name in Model.Names)
		{
			<code class="api-param-summary-item">@name</code>
		}
	</span>
	<span class="api-param-more" data-param-more hidden>
		<span class="api-param-more-badge" data-param-more-count></span>
	</span>
	@if (!variants)
	{
		<span class="api-param-summary-brace"> }</span>
	}
</span>
