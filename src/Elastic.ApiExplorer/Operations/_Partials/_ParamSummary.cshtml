@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.ParamSectionHeader>
<span class="api-param-summary" data-param-summary @(Model.NamesAreVariants ? new HtmlString("data-param-more-noun=\"variant\"") : HtmlString.Empty)>
	@if (!Model.NamesAreVariants)
	{
		<span class="api-param-summary-brace">{ </span>
	}
	<span class="api-param-summary-list@(Model.NamesAreVariants ? " is-variants" : "")" data-param-list>
		@foreach (var name in Model.Names)
		{
			<code class="api-param-summary-item">@name</code>
		}
	</span>
	<span class="api-param-more" data-param-more hidden>
		<span class="api-param-more-badge" data-param-more-count></span>
	</span>
	@if (!Model.NamesAreVariants)
	{
		<span class="api-param-summary-brace"> }</span>
	}
</span>
