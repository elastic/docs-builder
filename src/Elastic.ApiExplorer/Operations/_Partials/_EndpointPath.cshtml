@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<EndpointPathModel>
@* One merged route: dominant method badge, "also GET" for methods that behave the same, optional segments dashed. *@
@{
	var row = Model.Row;
}
<span class="api-url">
	@(await RenderPartialAsync<_HttpMethodBadge, string>(row.Method))
	@if (row.AlsoMethods.Count > 0)
	{
		var also = string.Join(", ", row.AlsoMethods.Select(static m => m.ToUpperInvariant()));
		<span class="api-url-also-method" data-tippy-content="@also works the same way: same parameters, body, and response.">also @also</span>
	}
	@* Segments on the brace lines: Razor would otherwise emit the indentation and line breaks as text, which inline layout shows as a space after each optional segment. *@
	<span class="api-url-path">@foreach (var segment in row.Segments)
	{
		var anchor = Model.AnchorFor(segment);
		if (segment.Optional)
		{<span class="api-url-optional" data-tippy-content="Optional. Leave it out to call @Model.ShortestRoute">/@if (anchor is not null){<a class="api-url-param" href="#@anchor">@segment.Text</a>}else{@segment.Text}</span>}
		else if (anchor is not null)
		{@("/")<a class="api-url-param" href="#@anchor">@segment.Text</a>}
		else
		{@("/" + segment.Text)}
	}</span>
</span>
