@using Elastic.ApiExplorer.Infrastructure
@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.SectionStripModel>
@* The strip says what each section holds and stays in the page. The capsule is the same links. Its wrapper sits right under the strip, so the capsule shows the moment the strip has scrolled away; the scroll-spy of ds/toc.ts marks the section in view in it. *@
@{
	var hasRequires = Model.Authorization.Privileges.Count > 0;
}
<div class="api-section-strip@(hasRequires ? " api-section-strip--requires" : "")" role="group" aria-label="Sections of this endpoint">
	@if (hasRequires)
	{
		<div class="api-section-requires" id="required-privileges">
			<h2 class="api-section-requires-title">Requires</h2>
			@(await RenderPartialAsync<_PrivilegeRows, AuthorizationSectionModel>(Model.Authorization))
			@if (Model.Authorization.Privileges.Any(static row => row.Values.Count > 0))
			{
				<span class="api-section-cell-caption">privileges</span>
			}
		</div>
	}
	@foreach (var link in Model.Links)
	{
		<a class="api-section-cell" href="#@link.Anchor">
			<span class="api-section-cell-label">@link.Label</span>
			@if (link.Stat is { } stat)
			{
				if (stat.Value is not null)
				{
					<span class="api-section-cell-value">@stat.Value</span>
				}
				<span class="api-section-cell-caption">@HtmlBreaks.After(stat.Caption, '/')</span>
			}
		</a>
	}
</div>
<div class="api-section-pin" data-section-pin>
	<nav class="api-section-links" aria-label="Sections of this endpoint" data-toc data-toc-sticky>
		<button type="button" class="api-back-to-top" aria-label="Back to top" data-tippy-content="Back to top" data-api-back-to-top>
			<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
		</button>
		<div class="api-section-links-track">
			@foreach (var link in Model.Links)
			{
				<a href="#@link.Anchor" data-toc-link>@link.Label</a>
			}
		</div>
		@(await RenderPartialAsync(_ExpandAllControl.Create(false)))
	</nav>
</div>
@(await RenderPartialAsync(_ExpandAllControl.Create(true)))
