@using Elastic.ApiExplorer.Operations
@inherits RazorSlice<Elastic.ApiExplorer.Operations.AuthorizationSectionModel>
@* Where the section strip is not shown the privileges stand alone, as a card about the caller apart from the parameter sections. *@
<section class="api-privileges-card" id="required-privileges" aria-labelledby="required-privileges-title">
	<h2 class="api-privileges-title" id="required-privileges-title">
		<svg class="api-privileges-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5.5" cy="10.5" r="2.75" /><path d="M7.6 8.4 13.5 2.5M11.25 4.75l1.5 1.5M9.5 6.5l1.25 1.25" /></svg>
		Required privileges
	</h2>
	@(await RenderPartialAsync<_PrivilegeRows, AuthorizationSectionModel>(Model))
</section>
