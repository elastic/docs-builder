@inherits RazorSlice<Elastic.ApiExplorer.Infrastructure.ParamSectionHeader>
<h2 class="section-header api-param-section-header" id="@Model.Anchor" data-section="@Model.Anchor" aria-label="@Model.Title">
	<a class="headerlink api-param-section-title" href="#@Model.Anchor">@Model.Title</a>
	<button
		type="button"
		class="api-param-section-toggle"
		aria-expanded="true"
		aria-controls="@Model.Anchor-list"
		aria-label="Toggle @Model.Title">
		@(await RenderPartialAsync<_ParamSummary, Elastic.ApiExplorer.Infrastructure.ParamSectionHeader>(Model))
		<span class="api-param-chevron" aria-hidden="true"></span>
	</button>
	@if (Model.LayoutSwitch)
	{
		<span class="api-param-layout" role="group" aria-label="@Model.Title layout" data-param-layout>
			<button type="button" class="api-param-layout-option" data-layout="list" aria-pressed="true">List</button>
			<button type="button" class="api-param-layout-option" data-layout="table" aria-pressed="false">Table</button>
		</span>
	}
</h2>
