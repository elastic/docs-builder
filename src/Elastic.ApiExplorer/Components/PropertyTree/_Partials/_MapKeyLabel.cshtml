@inherits RazorSlice<string?>
@* The row that holds a map's value fields. The model is its JSON path for the hover tooltip, or null where paths are not shown. *@
@if (Model is { } path)
{
	<code data-tooltip="@path" data-tooltip-theme="mono">@ApiProperty.MapKeyDisplayName</code>
}
else
{
	<code>@ApiProperty.MapKeyDisplayName</code>
}
<span class="values-label">@ApiProperty.MapKeyKind</span>
