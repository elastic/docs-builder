@inherits RazorSlice<Elastic.ApiExplorer.Components.PropertyTree.TypeAnnotation>
<code class="schema-type">@foreach (var s in Model.Spans){if (s.Bare){<span class="schema-type-sep">@s.Text</span>}else if (s.Href is { Length: > 0 } href){<a href="@href" class="@s.CssClass" data-tippy-content="@s.Title" data-hx-boost="false">@s.Text</a>}else if (s.Lead is { Length: > 0 } lead){<span class="schema-type-group"><span class="schema-type-sep">@lead</span><span class="@s.CssClass" data-tippy-content="@s.Title" tabindex="@(s.Title is { Length: > 0 } ? "0" : null)">@s.Text</span></span>}else{<span class="@s.CssClass" data-tippy-content="@s.Title" tabindex="@(s.CssClass == Elastic.ApiExplorer.Model.SchemaHelpers.ConstraintCssClass && s.Title is { Length: > 0 } ? "0" : null)">@s.Text</span>}}</code>
