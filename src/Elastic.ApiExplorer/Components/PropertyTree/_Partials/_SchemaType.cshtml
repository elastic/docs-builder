@inherits RazorSlice<Elastic.ApiExplorer.Components.PropertyTree.TypeAnnotation>
@* Razor keeps data-* attributes even when their value is null, so spans without a title branch to skip the tooltip. *@
<code class="schema-type">@foreach (var s in Model.Spans){var title = string.IsNullOrEmpty(s.Title) ? null : s.Title; if (s.Bare){<span class="schema-type-sep">@s.Text</span>}else if (s.Href is { Length: > 0 } href && title is not null){<a href="@href" class="@s.CssClass" data-tippy-content="@title" data-hx-boost="false">@s.Text</a>}else if (s.Href is { Length: > 0 } plainHref){<a href="@plainHref" class="@s.CssClass" data-hx-boost="false">@s.Text</a>}else if (title is not null){<span class="@s.CssClass" data-tippy-content="@title">@s.Text</span>}else{<span class="@s.CssClass">@s.Text</span>}}</code>
