@inherits RazorSlice<Elastic.ApiExplorer.Components.PropertyTree.TypeAnnotation>
<code class="schema-type">@foreach (var s in Model.Spans){if (s.Bare){<span class="schema-type-sep">@s.Text</span>}else if (s.Href is { Length: > 0 } href){<a href="@href" class="@s.CssClass" title="@s.Title" data-hx-boost="false">@s.Text</a>}else{<span class="@s.CssClass" title="@s.Title">@s.Text</span>}}</code>
