@inherits RazorSlice<Elastic.Codex.Landing.LandingViewModel>
@using System.Linq
@using Elastic.Codex.Landing
@using Elastic.Codex.Navigation
@implements IUsesLayout<Elastic.Codex._Layout, GlobalLayoutViewModel>
@functions {
	public GlobalLayoutViewModel LayoutModel => Model.CreateGlobalLayoutModel();
}
@{
	var layout = LayoutModel;
	var mcpUrl = layout.CanonicalBaseUrl is { } canonical
		? $"{canonical.AbsoluteUri.TrimEnd('/')}/mcp"
		: "https://codex.elastic.dev/mcp";
	var totalGroups = Model.CodexNavigation?.GroupNavigations?.Count ?? 0;
	var totalDocSets = Model.CodexNavigation?.DocumentationSetInfos?.Count ?? 0;
	var totalPages = Model.CodexNavigation?.DocumentationSetInfos?.Sum(ds => ds.PageCount) ?? 0;
}
@{
	var content = new CodexLandingContent(
		layout.HeaderTitle ?? layout.DocSetName,
		mcpUrl,
		totalGroups,
		totalDocSets,
		totalPages,
		[
			.. Model.Groups.Select(group => new CodexSection(
				group.DisplayTitle,
				group.Url,
				group.Description,
				group.DocumentationSetInfos.Count,
				[.. group.DocumentationSetInfos.OrderBy(ds => ds.Title).Select(CodexCardModel.FromDocumentationSet)])),
			.. Model.UngroupedDocumentationSets.Any()
				? [new CodexSection(
					"Documentation sets",
					null,
					null,
					Model.UngroupedDocumentationSets.Count(),
					[.. Model.UngroupedDocumentationSets.OrderBy(ds => ds.Title).Select(CodexCardModel.FromDocumentationSet)],
					"codex-grid")]
				: Array.Empty<CodexSection>()
		]);
}
@await RenderPartialAsync(_DesignSystemCodexLanding.Create(content))
