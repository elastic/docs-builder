<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The docs API's OpenAPI document reads its descriptions from these doc comments. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Elastic.Documentation.Search.Contract</AssemblyName>
    <RootNamespace>Elastic.Documentation.Search.Contract</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
        <!-- The contract deliberately exposes two namespaces (root + .Mapping) over
             concern-based folders (Common/, Search/, Site/, ...) -->
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Mapping" />
  </ItemGroup>

</Project>
