@inherits RazorLayoutSlice<StyleGuideViewModel>
@using Elastic.Documentation.Site.StyleGuide
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="noindex, nofollow">
	<title>@Model.Page.Title · Style guide</title>
	<script>try{var t=localStorage.getItem("docs-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}try{var m=localStorage.getItem("docs-motion");document.documentElement.dataset.motion=m==="full"||m==="reduce"?m:(matchMedia("(prefers-reduced-motion: reduce)").matches?"reduce":"full")}catch(e){document.documentElement.dataset.motion="reduce"}</script>
	<link rel="stylesheet" href="@Model.Static("ds-layers.css")">
	<link rel="stylesheet" href="@Model.Static("ds.css")">
	<link rel="stylesheet" href="@Model.Static("ds-guide.css")">
	<script type="module" src="@Model.Static("ds.js")"></script>
</head>
<body>
<div class="layout layout--two sg-layout">
	<input class="layout__drawer-toggle" type="checkbox" id="pages-nav-hamburger">
	<label class="layout__scrim" for="pages-nav-hamburger" aria-hidden="true"></label>
	<aside class="layout__nav" id="pages-nav">
		<nav class="sg-nav" aria-label="Style guide">
			<a class="sg-nav__brand" href="@StyleGuideCatalog.Route">Style guide</a>
			@foreach (var group in Model.Pages.GroupBy(p => p.Group))
			{
				<span class="sg-nav__group">@group.Key</span>
				@foreach (var entry in group)
				{
					<a href="@StyleGuideCatalog.Route/@entry.Slug" aria-current="@(entry.Slug == Model.Page.Slug ? "page" : null)">@entry.Title</a>
				}
			}
		</nav>
	</aside>
	<div class="layout__main">
	<main class="layout__content" id="main">
		<label class="layout__menu-button" for="pages-nav-hamburger"><span>Menu</span></label>
		<header class="sg-header">
			<div>
				<h1>@Model.Page.Title</h1>
				<p class="sg-header__lead">@Model.Page.Lead</p>
			</div>
			@if (!Model.Offline)
			{
				<a class="sg-toggle" href="@StyleGuideCatalog.Route/download.zip" download>Download</a>
			}
			<button type="button" class="sg-toggle" data-motion-toggle>Motion</button>
			<button type="button" class="sg-toggle" data-theme-toggle>Theme</button>
		</header>
		@await RenderBodyAsync()
	</main>
	</div>
</div>
</body>
</html>
