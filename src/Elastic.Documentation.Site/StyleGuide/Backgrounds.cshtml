@inherits RazorSlice<StyleGuideViewModel>
@using Elastic.Documentation.Site.StyleGuide
@implements IUsesLayout<Elastic.Documentation.Site.StyleGuide._StyleGuideLayout, StyleGuideViewModel>
@functions {
	public StyleGuideViewModel LayoutModel => Model;
}
@{
	var variants = new[]
	{
		(Class: "band", Title: "Plain", Tokens: "--color-surface", Text: "The page itself. Only where a section holds a single dense block, such as a table or a form.", Used: "Documentation pages"),
		(Class: "band band--soft", Title: "Soft grey", Tokens: "grain, a light grey ground", Text: "A calm grey with a trace of colour and film grain. White cards stand out on it.", Used: "The solutions section of the landing page"),
		(Class: "band band--tint", Title: "Blue tint", Tokens: "--color-accent-surface", Text: "A pale blue that fades down, with grain. Good for a section that links elsewhere.", Used: "The product resources of the landing page"),
		(Class: "band band--dots", Title: "Dots", Tokens: "a dot grid on grey", Text: "A fine dot grid. Quiet texture behind cards.", Used: "The how-to guides of the landing page"),
		(Class: "band band--grid", Title: "Grid", Tokens: "a line grid on white", Text: "A technical line grid, for reference and API sections.", Used: "Reference hubs"),
		(Class: "band band--hatch", Title: "Hatch", Tokens: "a diagonal hatch on grey", Text: "The diagonal hatch the hub pages already use, as a band of its own.", Used: "Hub pages"),
		(Class: "band band--halftone", Title: "Halftone", Tokens: "blue dots that fade across", Text: "Blue dots fading from the left, over white. A statement section.", Used: "Announcements"),
		(Class: "band band--wash", Title: "Colour wash", Tokens: "blue, teal and pink washes", Text: "Soft blue, teal and pink corners on white. The friendliest of the set.", Used: "The first section and the call to action of the landing page"),
		(Class: "band band--soft band--wash-a", Title: "Soft grey with wash A", Tokens: "band--wash-a", Text: "A wash layers over any texture: blue top left and teal bottom right.", Used: "Landing and hub sections"),
		(Class: "band band--dots band--wash-b", Title: "Dots with wash B", Tokens: "band--wash-b", Text: "Pink top right and blue bottom left.", Used: "Landing and hub sections"),
		(Class: "band band--grid band--wash-c", Title: "Grid with wash C", Tokens: "band--wash-c", Text: "Teal rising from the bottom with a violet corner.", Used: "Codex sections"),
		(Class: "band band--ink", Title: "Ink", Tokens: "--palette-developer-blue", Text: "A flat midnight band for the one block that should read as a change of pace.", Used: "The reference band of the landing page"),
		(Class: "band band--blue", Title: "Blue", Tokens: "a blue gradient", Text: "Elastic blue into midnight, with grain.", Used: "Promotions"),
		(Class: "band band--lagoon", Title: "Lagoon", Tokens: "teal and sky washes", Text: "A bright teal band with dark text, the only bright one. Use it once.", Used: "Highlights"),
		(Class: "band band--dusk", Title: "Dusk", Tokens: "a blue to violet gradient", Text: "Midnight through blue to violet.", Used: "Codex and events"),
		(Class: "band band--aurora", Title: "Aurora", Tokens: "teal and pink glows on ink", Text: "Teal and pink glows on midnight. The boldest dark band.", Used: "Launches")
	};
}
<section class="sg-section">
	<h2>Band backgrounds</h2>
	<p>A band is a full-width strip, and its content sits in <code>band__content</code>. Padding and background are separate: <code>band</code> gives the section rhythm, and one background modifier says what is behind it. The backgrounds are the theme's surface art, each with a dimmed counterpart in dark and in true black. The dark ones and the lagoon band open a colour scope of their own, so cards and text inside them read on them. Try to avoid a page of plain white sections: alternate a texture, a wash and, once, a dark band.</p>
</section>
@foreach (var variant in variants)
{
	<section class="sg-section">
		<h2>@variant.Title</h2>
		<p>@variant.Text</p>
		<div class="sg-bgsample">
			<div class="@variant.Class">
				<div class="band__content stack stack--tight">
					<p class="sg-bgsample__eyebrow">Elastic Docs</p>
					<p class="sg-bgsample__title">Build, run and scale with Elastic</p>
					<p class="sg-bgsample__text">Welcome to the technical documentation. Deploy, operate and scale with step-by-step guides, API references and examples.</p>
				</div>
			</div>
		</div>
		<table class="sg-table">
			<thead><tr><th>Class</th><th>Tokens</th><th>Used by</th></tr></thead>
			<tbody><tr><td><code>@variant.Class</code></td><td><code>@variant.Tokens</code></td><td>@variant.Used</td></tr></tbody>
		</table>
	</section>
}
<section class="sg-section">
	<h2>Choosing one</h2>
	<ol>
		<li>A page that is a stack of bands (<code>layout--bands</code>) alternates them: a hero first, then a wash, a texture and a tint for the sections, a dark band for the one block that should stand out, and a call-to-action band last.</li>
		<li>Use a dark or bright band at most once or twice a page, so each still reads as a change of pace.</li>
		<li>Do not set a background colour in a page's own CSS. If none of these fits, that is a gap to bring back here.</li>
	</ol>
</section>
