@inherits RazorSlice<Elastic.Documentation.Site.Layout.BreadcrumbsView>
@using Elastic.Documentation
@functions {
	static string StripBadge(string t) =>
		t.StartsWith("[ns]", StringComparison.Ordinal) ? t[4..] :
		t.StartsWith("[cmd]", StringComparison.Ordinal) ? t[5..] : t;
}
@if (Model.Items.Count > 0 && (Model.Items.Count > 1 || Model.BuildType != BuildType.Isolated))
{
<ol id="breadcrumbs" class="flex flex-wrap gap-1 items-center w-full pt-6">
	@for (var i = 0; i < Model.Items.Count; i++)
	{
		var item = Model.Items[i];
		<li class="text-ink-light text-sm leading-[1.2em]">
			<a
				itemprop="item"
				href="@item.Url"
				@(i == 0 ? "hx-disable=true" : "")
				preload="mousedown">
				<span class="hover:text-black">@StripBadge(item.NavigationTitle)</span>
			</a>
			@if (i < Model.Items.Count - 1)
			{
				<span class="px-1">/</span>
			}
		</li>
	}
</ol>
}
