@inherits RazorSlice<Elastic.Documentation.Site.GlobalLayoutViewModel>
@using Elastic.Documentation.Site.Components.Chrome.Feedback
@if (Model.ShowPageFeedback)
{
	@await RenderPartialAsync(_Feedback.Create(new FeedbackModel
	{
		PageUrl = Model.CurrentNavigationItem.Url,
		PageTitle = Model.Title,
		ApiBase = Model.FrontendConfig.ApiBasePath,
		Surface = Model.PageFeedbackSurface == "api" ? FeedbackSurface.Api : FeedbackSurface.Docs
	}))
}
