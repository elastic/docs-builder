@using Elastic.Documentation.Configuration.Toc
@using Microsoft.AspNetCore.Html
@inherits RazorSlice<Elastic.Documentation.Site.GlobalLayoutViewModel>
@{
	var topNav = Model.TopNav;
	// Active tab: compare the current page's NavigationRoot.Id against each tab's SectionId.
	// The site root (SiteNavigation) has an Id that matches no tab, so homepage gets no active tab.
	var currentSectionId = Model.CurrentNavigationItem.NavigationRoot?.Id;
	var docsHomeUrl = Model.Link("/");

	string? IconSlug(string title) => title switch
	{
		"Guides" => "guides",
		"Reference" => "reference",
		"Troubleshoot" => "troubleshoot",
		"Products" => "products",
		"APIs" => "apis",
		"Release notes" => "release-notes",
		_ => null
	};

	string IconSrc(string slug) => Model.Static($"secondary-nav-{slug}.svg");
}
<div id="secondary-nav-host" class="relative md:sticky md:top-0 md:z-30 bg-white">
	<nav id="secondary-nav">
		@if (topNav is not null)
		{
			@* navigation-preview: desktop section-driven top nav.
			   secondary-nav-dropdown.css lets an open dropdown escape the overflow clipping. *@
			<div class="secondary-nav-bar secondary-nav-bar--desktop">
				<div class="secondary-nav-scroll-container">
				<a href="@docsHomeUrl"
				   class="secondary-nav-home"
				   preload="mousedown">Docs</a>
				<ul class="secondary-nav-list">
					@foreach (var item in topNav.Items)
					{
						var isActive = item.IsActive(currentSectionId);
						var itemClass = isActive ? "secondary-nav-item secondary-nav-item--active" : "secondary-nav-item";
						var iconSlug = IconSlug(item.Title);
						if (item is TopNavDropdownItem dropdown)
						{
							<li class="@itemClass">
								<details class="secondary-nav-dropdown">
									<summary class="secondary-nav-item__hit">
										<span class="secondary-nav-item__content secondary-nav-item__content--dropdown">
											@if (iconSlug is not null)
											{
												var iconSrc = IconSrc(iconSlug);
												<span class="secondary-nav-icon" style="--secondary-nav-icon: url('@iconSrc')" aria-hidden="true">
													<img src="@iconSrc" alt="" width="16" height="16">
												</span>
											}
											<span>@dropdown.Title</span>
											@{
												var chevronSrc = IconSrc("chevron");
											}
											<span class="secondary-nav-icon secondary-nav-icon--sm secondary-nav-dropdown-chevron" style="--secondary-nav-icon: url('@chevronSrc')" aria-hidden="true">
												<img src="@chevronSrc" alt="" width="10" height="5">
											</span>
										</span>
									</summary>
									<div class="secondary-nav-dropdown-menu" aria-label="@dropdown.Title">
										@foreach (var group in dropdown.Groups)
										{
											if (group.Label is not null)
											{
												<div class="secondary-nav-dropdown-group-label">@group.Label</div>
											}
											foreach (var link in group.Links)
											{
												<a class="secondary-nav-dropdown-link"
												   href="@link.Url"
												   preload="mousedown">@link.Title</a>
											}
										}
									</div>
								</details>
							</li>
						}
						else if (item is TopNavLinkItem link)
						{
							var sectionIdsAttr = link.SectionIds is { Count: > 0 }
								? string.Join(" ", link.SectionIds)
								: link.SectionId;
							<li class="@itemClass" data-section-ids="@sectionIdsAttr">
								@if (link.IsExternal)
								{
									var externalSrc = IconSrc("external");
									<a href="@link.Url"
									   target="_blank"
									   rel="noopener noreferrer"
									   class="secondary-nav-item__hit">
										<span class="secondary-nav-item__content">
											@if (iconSlug is not null)
											{
												var iconSrc = IconSrc(iconSlug);
												<span class="secondary-nav-icon" style="--secondary-nav-icon: url('@iconSrc')" aria-hidden="true">
													<img src="@iconSrc" alt="" width="16" height="16">
												</span>
											}
											<span>@link.Title</span>
											<span class="secondary-nav-icon secondary-nav-icon--sm secondary-nav-icon--external" style="--secondary-nav-icon: url('@externalSrc')" aria-hidden="true">
												<img src="@externalSrc" alt="" width="8" height="8">
											</span>
										</span>
										<span class="sr-only">(opens in a new tab)</span>
									</a>
								}
								else
								{
									<a href="@link.Url"
									   preload="mousedown"
									   class="secondary-nav-item__hit">
										<span class="secondary-nav-item__content">
											@if (iconSlug is not null)
											{
												var iconSrc = IconSrc(iconSlug);
												<span class="secondary-nav-icon" style="--secondary-nav-icon: url('@iconSrc')" aria-hidden="true">
													<img src="@iconSrc" alt="" width="16" height="16">
												</span>
											}
											<span>@link.Title</span>
										</span>
									</a>
								}
							</li>
						}
					}
				</ul>
				</div>
				@if (Model.ShowVersionDropdown)
				{
					<div class="secondary-nav-actions">
						<version-dropdown all-versions-url="@Model.AllVersionsUrl" current-version='@(Model.CurrentVersion)' items='@(new HtmlString(Model.VersionDropdownSerializedModel))'>
							<div class="h-8">@*height of dropdown button*@</div>
						</version-dropdown>
					</div>
				}
			</div>
		}
		else
		{
			@* Built-in links: flag off, isolated builds, and any build without section: entries. *@
			<div class="secondary-nav-bar">
				<a href="@docsHomeUrl"
				   class="secondary-nav-home"
				   preload="mousedown">Docs</a>
				<ul class="secondary-nav-list">
					<li class="secondary-nav-item">
						<a href="@Model.Link("/release-notes/")"
						   preload="mousedown"
						   class="secondary-nav-item__hit">
							<span class="secondary-nav-item__content">
								@{
									var releaseNotesSrc = IconSrc("release-notes");
								}
								<span class="secondary-nav-icon" style="--secondary-nav-icon: url('@releaseNotesSrc')" aria-hidden="true">
									<img src="@releaseNotesSrc" alt="" width="16" height="16">
								</span>
								<span>Release notes</span>
							</span>
						</a>
					</li>
					<li class="secondary-nav-item">
						<a href="@Model.Link("/troubleshoot/")"
						   preload="mousedown"
						   class="secondary-nav-item__hit">
							<span class="secondary-nav-item__content">
								@{
									var troubleshootSrc = IconSrc("troubleshoot");
								}
								<span class="secondary-nav-icon" style="--secondary-nav-icon: url('@troubleshootSrc')" aria-hidden="true">
									<img src="@troubleshootSrc" alt="" width="16" height="16">
								</span>
								<span>Troubleshoot</span>
							</span>
						</a>
					</li>
					<li class="secondary-nav-item">
						<a href="@Model.Link("/reference/")"
						   preload="mousedown"
						   class="secondary-nav-item__hit">
							<span class="secondary-nav-item__content">
								@{
									var referenceSrc = IconSrc("reference");
								}
								<span class="secondary-nav-icon" style="--secondary-nav-icon: url('@referenceSrc')" aria-hidden="true">
									<img src="@referenceSrc" alt="" width="16" height="16">
								</span>
								<span>Reference</span>
							</span>
						</a>
					</li>
				</ul>
				@if (Model.ShowVersionDropdown)
				{
					<div class="secondary-nav-actions">
						<version-dropdown all-versions-url="@Model.AllVersionsUrl" current-version='@(Model.CurrentVersion)' items='@(new HtmlString(Model.VersionDropdownSerializedModel))'>
							<div class="h-8">@*height of dropdown button*@</div>
						</version-dropdown>
					</div>
				}
			</div>
		}
	</nav>
</div>
