@using Elastic.Documentation.Site.Navigation
@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.Site.Navigation.NavigationRenderNode>>
@foreach (var item in Model)
{
	if (item.Kind == NavigationRenderNodeKind.Leaf)
	{
		<li class="flex group/li pr-8 @(item.IsTopLevel ? "font-semibold mt-6" : "mt-4")">
			<a href="@item.Url" class="sidebar-link nav-link">
				<span>@item.NavigationTitle</span>
				@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
			</a>
		</li>
	}
	else if (item.Kind == NavigationRenderNodeKind.Island)
	{
		<li class="nav-folder @(item.IsTopLevel ? "mt-6" : "mt-4")">
			<div class="peer grid grid-cols-[1fr_auto] w-full">
				<a href="@item.Url" class="sidebar-link nav-folder-link@(item.IsTopLevel ? " font-semibold" : "")">
					<span>@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
				</a>
				<a href="@item.Url" class="group/label flex mr-2 items-start">
					<div class="nav-toggle-btn">
						<svg class="nav-chevron" viewBox="0 0 24 24"><use href="#icon-chevron-double-down"/></svg>
					</div>
				</a>
			</div>
		</li>
	}
	else
	{
		<li class="nav-folder @(item.IsTopLevel ? "mt-6" : "mt-4")">
			<div class="peer grid grid-cols-[1fr_auto] w-full">
				<a href="@item.Url" class="sidebar-link nav-folder-link@(item.IsTopLevel ? " font-semibold" : "")">
					<span>@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
				</a>
				@if (item.ShowToggle)
				{
					<label for="@item.Id" class="group/label flex mr-2 items-start">
						<div class="nav-toggle-btn">
							<svg class="nav-chevron" viewBox="0 0 24 24"><use href="#icon-chevron-down"/></svg>
						</div>
						<input
							id="@item.Id"
							type="checkbox"
							class="hidden"
							aria-hidden="true">
					</label>
				}
			</div>
			<ul class="nav-subtree">
				@await RenderPartialAsync(_TocTreeNav.Create(item.NavigationItems))
			</ul>
		</li>
	}
}
