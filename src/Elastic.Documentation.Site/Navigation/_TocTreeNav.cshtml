@using Elastic.Documentation.Site.Navigation
@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.Site.Navigation.NavigationRenderNode>>
@foreach (var item in Model)
{
	if (item.Kind == NavigationRenderNodeKind.Leaf)
	{
		<li class="flex group/li">
			<a href="@item.Url" class="sidebar-link nav-link nav-v2-link">
				<span class="nav-v2-nav-text">@item.NavigationTitle</span>
				@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
			</a>
		</li>
	}
	else if (item.Kind == NavigationRenderNodeKind.Island)
	{
		<li class="nav-folder">
			<div class="peer nav-folder-peer w-full">
				<a href="@item.Url" class="sidebar-link nav-folder-link nav-v2-link">
					<span class="nav-v2-nav-text">@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
					<span class="nav-island-arrow" aria-hidden="true">
						<svg class="nav-island-chevron" viewBox="0 0 16 16"><use href="#icon-chevron-limit-right"/></svg>
					</span>
				</a>
			</div>
		</li>
	}
	else
	{
		<li class="nav-folder">
			<div class="peer nav-folder-peer w-full">
				@if (item.ShowToggle)
				{
					<input
						id="@item.Id"
						type="checkbox"
						class="hidden"
						tabindex="-1"
						aria-hidden="true">
				}
				<a href="@item.Url" class="sidebar-link nav-folder-link nav-v2-link">
					<span class="nav-v2-nav-text">@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
					@if (item.ShowToggle)
					{
						<span class="nav-folder-chevron" aria-hidden="true">
							<svg class="nav-chevron" viewBox="0 0 16 16"><use href="#icon-chevron-down"/></svg>
						</span>
					}
				</a>
			</div>
			<ul class="nav-subtree">
				@await RenderPartialAsync(_TocTreeNav.Create(item.NavigationItems))
			</ul>
		</li>
	}
}
