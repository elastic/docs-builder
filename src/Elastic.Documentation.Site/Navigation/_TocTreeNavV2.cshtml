@using Elastic.Documentation.Navigation
@using Elastic.Documentation.Navigation.Isolated
@using Elastic.Documentation.Navigation.Isolated.Leaf
@using Elastic.Documentation.Navigation.V2
@using Elastic.Documentation.Site.Navigation
@inherits RazorSlice<NavigationTreeItem>
@{
	var isTopLevel = Model.Level == 0 && Model.SubTree is not LabelNavigationNode;
	var navHxAttrs = Model.Htmx.GetNavHxAttributes(hasSameTopLevelGroup: true, preload: null);

	NavigationTreeItem ChildTreeItem(INodeNavigationItem<INavigationModel, INavigationItem> subTree, int level) =>
		new()
		{
			IsPrimaryNavEnabled = Model.IsPrimaryNavEnabled,
			IsGlobalAssemblyBuild = Model.IsGlobalAssemblyBuild,
			Level = level,
			SubTree = subTree,
			RootNavigationId = Model.RootNavigationId,
			Htmx = Model.Htmx,
			IsIslandSubtree = Model.IsIslandSubtree,
			ActiveNavigationUrl = Model.ActiveNavigationUrl
		};
}
@foreach (var item in Model.SubTree.NavigationItems)
{
	if (item.Hidden)
	{
		continue;
	}

	if (item is INavigationSidebarLabel and INodeNavigationItem<INavigationModel, INavigationItem> label)
	{
		var labelBodyIsSubsection = label is LabelNavigationNode labelNode && NavV2LabelListKind.IsSubsectionList(labelNode);
		var labelBodyClass = labelBodyIsSubsection
			? "docs-sidebar-nav-v2__subsection"
			: "docs-sidebar-nav-v2__items-list";
		@* Main Group Item — maps to Figma "Main Group Item" (one li per block in __tree). *@
		<li class="docs-sidebar-nav-v2__main-group">
			@if (isTopLevel)
			{
				<div class="docs-sidebar-nav-v2__title docs-sidebar-nav-v2__block-top">
					<span class="docs-sidebar-nav-v2__label docs-sidebar-nav-v2__label--top docs-sidebar-nav-v2__nav-text">
						@label.NavigationTitle
					</span>
				</div>
			}
			else
			{
				<div class="docs-sidebar-nav-v2__subtitle docs-sidebar-nav-v2__block-subtitle">
					<span class="docs-sidebar-nav-v2__label docs-sidebar-nav-v2__label--nested docs-sidebar-nav-v2__nav-text">
						@label.NavigationTitle
					</span>
				</div>
			}
			@if (label.NavigationItems.Count > 0)
			{
				<ul class="@labelBodyClass">
					@await RenderPartialAsync(_TocTreeNavV2.Create(ChildTreeItem(label, Model.Level)))
				</ul>
			}
		</li>
	}
	else if (item is PlaceholderNavigationLeaf placeholder)
	{
		<li class="docs-sidebar-nav-v2__list-item docs-sidebar-nav-v2__list-item--leaf">
			<div class="docs-sidebar-nav-v2__item-content">
				<a
					href="@placeholder.Url"
					@navHxAttrs
					class="@TocTreeNavV2Helpers.NavLinkClass(Model.ActiveNavigationUrl, placeholder.Url)">
					<span class="nav-item-slot shrink-0" aria-hidden="true"></span>
					<span class="docs-sidebar-nav-v2__nav-text min-w-0 flex-1">@placeholder.NavigationTitle</span>
				</a>
			</div>
		</li>
	}
	else if (item is PlaceholderNavigationNode placeholderGroup)
	{
		@await RenderPartialAsync(_TocTreeNavV2Folder.Create(new NavV2FolderRenderModel
		{
			Id = placeholderGroup.Id,
			Url = placeholderGroup.Url,
			Title = placeholderGroup.NavigationTitle,
			AllHidden = placeholderGroup.NavigationItems.All(n => n.Hidden),
			IsOpen = NavigationActiveUrlResolver.TreeContainsActiveUrl(placeholderGroup, Model.ActiveNavigationUrl),
			HasChildren = placeholderGroup.NavigationItems.Count > 0,
			HxAttributes = navHxAttrs,
			ActiveNavigationUrl = Model.ActiveNavigationUrl,
			ChildTree = ChildTreeItem(placeholderGroup, Model.Level + 1)
		}))
	}
	else if (item is IslandNavigationNode island)
	{
		var islandHxAttrs = Model.Htmx.GetHxAttributes(
			hxSwapOob: "#content-container,#toc-nav,#api-examples-panel,#pages-nav",
			preload: null);
		@await RenderPartialAsync(_TocTreeNavV2Folder.Create(new NavV2FolderRenderModel
		{
			Id = island.Id,
			Url = island.Url,
			Title = island.NavigationTitle,
			AllHidden = island.NavigationItems.All(n => n.Hidden),
			IsOpen = NavigationActiveUrlResolver.TreeContainsActiveUrl(island, Model.ActiveNavigationUrl),
			HasChildren = island.NavigationItems.Count > 0,
			HxAttributes = islandHxAttrs,
			ActiveNavigationUrl = Model.ActiveNavigationUrl,
			ChildTree = new NavigationTreeItem
			{
				IsPrimaryNavEnabled = Model.IsPrimaryNavEnabled,
				IsGlobalAssemblyBuild = Model.IsGlobalAssemblyBuild,
				Level = Model.Level + 1,
				SubTree = island,
				RootNavigationId = Model.RootNavigationId,
				Htmx = Model.Htmx,
				IsIslandSubtree = true,
				ActiveNavigationUrl = Model.ActiveNavigationUrl
			}
		}))
	}
	else if (item is INodeNavigationItem<INavigationModel, INavigationItem> { NavigationItems.Count: 0 } group)
	{
		<li class="docs-sidebar-nav-v2__list-item docs-sidebar-nav-v2__list-item--leaf">
			<div class="docs-sidebar-nav-v2__item-content">
				<a
					href="@group.Url"
					@navHxAttrs
					class="@TocTreeNavV2Helpers.NavLinkClass(Model.ActiveNavigationUrl, group.Url)">
					<span class="nav-item-slot shrink-0" aria-hidden="true"></span>
					<span class="docs-sidebar-nav-v2__nav-text min-w-0 flex-1">@group.NavigationTitle</span>
				</a>
			</div>
		</li>
	}
	else if (item is INodeNavigationItem<INavigationModel, INavigationItem> folder)
	{
		@await RenderPartialAsync(_TocTreeNavV2Folder.Create(new NavV2FolderRenderModel
		{
			Id = folder.Id,
			Url = folder.Url,
			Title = folder.NavigationTitle,
			AllHidden = folder.NavigationItems.All(n => n.Hidden),
			IsOpen = NavigationActiveUrlResolver.TreeContainsActiveUrl(folder, Model.ActiveNavigationUrl),
			HasChildren = folder.NavigationItems.Count > 0,
			HxAttributes = navHxAttrs,
			ActiveNavigationUrl = Model.ActiveNavigationUrl,
			ChildTree = ChildTreeItem(folder, Model.Level + 1)
		}))
	}
	else if (item is ILeafNavigationItem<INavigationModel> leaf)
	{
		<li class="docs-sidebar-nav-v2__list-item docs-sidebar-nav-v2__list-item--leaf">
			<div class="docs-sidebar-nav-v2__item-content">
				<a
					href="@leaf.Url"
					@navHxAttrs
					class="@TocTreeNavV2Helpers.NavLinkClass(Model.ActiveNavigationUrl, leaf.Url)">
					<span class="nav-item-slot shrink-0" aria-hidden="true"></span>
					<span class="docs-sidebar-nav-v2__nav-text min-w-0 flex-1">@leaf.NavigationTitle</span>
				</a>
			</div>
		</li>
	}
}
