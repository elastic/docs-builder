@using Elastic.Documentation.Site.Navigation
@inherits RazorSlice<IReadOnlyList<Elastic.Documentation.Site.Navigation.NavigationRenderNode>>
@foreach (var item in Model)
{
	if (item.Kind == NavigationRenderNodeKind.Separator)
	{
		<li role="separator" class="mt-4 pr-8"><hr class="border-grey-20"></li>
	}
	else if (item.Kind == NavigationRenderNodeKind.Leaf)
	{
		@* Leaf rows carry no layout classes: the tree's CSS in styles.css lays them out, so the classes are not repeated on every row. *@
		<li class="@(item.IsTopLevel ? "nav-top" : null)">
			@* A single method is drawn as the link's ::after chip from data-method (api-docs.css, api-reference.css). *@
			<a href="@item.Url" class="sidebar-link@(item.Deprecated ? " nav-link--deprecated" : "")"@(item.SingleHttpMethod is { } method ? new Microsoft.AspNetCore.Html.HtmlString($" data-method=\"{method}\"") : Microsoft.AspNetCore.Html.HtmlString.Empty)@(item.Url.Contains('#') ? new Microsoft.AspNetCore.Html.HtmlString(" hx-boost=\"false\"") : Microsoft.AspNetCore.Html.HtmlString.Empty)>
				<span>@item.NavigationTitle</span>
				@if (item.Deprecated) { <span class="sr-only">Deprecated</span> }
				@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
				@if (item.SingleHttpMethod is null)
				{
					@await RenderPartialAsync(_NavHttpMethodGlyph.Create(item))
				}
			</a>
		</li>
	}
	else if (item.Kind == NavigationRenderNodeKind.Island)
	{
		<li class="nav-folder @(item.IsTopLevel ? "mt-6" : "mt-4")">
			<div class="peer grid grid-cols-[1fr_auto] w-full">
				<a href="@item.Url" class="sidebar-link nav-folder-link@(item.IsTopLevel ? " font-semibold" : "")">
					<span>@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
				</a>
				<a href="@item.Url" class="group/label flex mr-2 items-start">
					<div class="nav-toggle-btn">
						<svg class="nav-chevron" viewBox="0 0 24 24"><use href="#icon-chevron-double-down"/></svg>
					</div>
				</a>
			</div>
		</li>
	}
	else if (item.Kind == NavigationRenderNodeKind.Group)
	{
		<li class="nav-group mt-7">
			<span id="@item.Id-label" class="nav-group-label">@item.NavigationTitle</span>
			<ul class="nav-group-items" aria-labelledby="@item.Id-label">
				@await RenderPartialAsync(_TocTreeNavLegacy.Create(item.NavigationItems))
			</ul>
		</li>
	}
	else if (item.Kind == NavigationRenderNodeKind.Heading)
	{
		@* Folder and heading rows carry no layout classes on the peer and the toggle: styles.css sets them. *@
		<li class="nav-folder @(item.IsTopLevel ? "mt-6" : "mt-4")">
			<div class="peer">
				<span class="sidebar-link nav-folder-link@(item.IsTopLevel ? " font-semibold" : "")">
					<span>@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
				</span>
				@if (item.ShowToggle)
				{
					<label for="@item.Id">
						<svg class="nav-chevron" viewBox="0 0 24 24"><use href="#icon-chevron-down"/></svg>
						<input
							id="@item.Id"
							type="checkbox"
							class="hidden"
							aria-hidden="true"@(item.Expanded ? " checked data-nav-default-open" : "")>
					</label>
				}
			</div>
			<div class="nav-subtree-clip@(item.Expanded ? " nav-subtree-clip--open" : "")">
				<ul class="nav-subtree">
					@await RenderPartialAsync(_TocTreeNavLegacy.Create(item.NavigationItems))
				</ul>
			</div>
		</li>
	}
	else
	{
		<li class="nav-folder @(item.IsTopLevel ? "mt-6" : "mt-4")">
			<div class="peer">
				<a href="@item.Url" class="sidebar-link nav-folder-link@(item.IsTopLevel ? " font-semibold" : "")">
					<span>@item.NavigationTitle</span>
					@if (item.Badge is not null) { <span class="nav-badge nav-badge-@item.Badge">@item.Badge</span> }
					@await RenderPartialAsync(_NavHttpMethodGlyph.Create(item))
				</a>
				@if (item.ShowToggle)
				{
					<label for="@item.Id">
						<svg class="nav-chevron" viewBox="0 0 24 24"><use href="#icon-chevron-down"/></svg>
						<input
							id="@item.Id"
							type="checkbox"
							class="hidden"
							aria-hidden="true"@(item.Expanded ? " checked data-nav-default-open" : "")>
					</label>
				}
			</div>
			<div class="nav-subtree-clip@(item.Expanded ? " nav-subtree-clip--open" : "")">
				<ul class="nav-subtree">
					@await RenderPartialAsync(_TocTreeNavLegacy.Create(item.NavigationItems))
				</ul>
			</div>
		</li>
	}
}
