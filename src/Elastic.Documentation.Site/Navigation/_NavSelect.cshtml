@using Elastic.Documentation.Site.Navigation
@inherits RazorSlice<Elastic.Documentation.Site.Navigation.NavigationSelectModel>
@{
	var current = Model.Current;
}
<details class="nav-select-dropdown" id="@Model.Id">
	<summary class="nav-select" aria-label="@Model.AriaLabel">
		<span class="nav-select__body">
			<span class="nav-select__value">@current.Label</span>
			<span class="nav-select__chevron" aria-hidden="true">
				<svg viewBox="0 0 16 16"><use href="#icon-chevron-down"/></svg>
			</span>
		</span>
	</summary>
	<div class="nav-select-menu" role="listbox" aria-label="@Model.AriaLabel">
		@foreach (var option in Model.Options)
		{
			var selectedClass = option.Selected ? " nav-select-option--selected" : "";
			if (Model.UseLinks)
			{
				<a class="nav-select-option@(selectedClass)"
				   href="@option.Value"
				   role="option"
				   aria-selected="@(option.Selected ? "true" : "false")"
				   hx-boost="false">@option.Label</a>
			}
			else
			{
				<button type="button"
						class="nav-select-option@(selectedClass)"
						role="option"
						aria-selected="@(option.Selected ? "true" : "false")"
						data-scenario="@option.Value">@option.Label</button>
			}
		}
	</div>
</details>
