@inherits RazorSlice<Elastic.Documentation.Site.Components.Flyout.FlyoutModel>
@* The dialog needs script to open, so the trigger stays hidden until script finds it. *@
<button class="btn btn--secondary" type="button" data-flyout-open="@Model.Id" hidden>@Model.OpenLabel</button>
<dialog class="flyout" id="@Model.Id" aria-labelledby="@(Model.Id)-title" data-flyout>
	<header class="flyout__header">
		<h2 class="flyout__title" id="@(Model.Id)-title">@Model.Title</h2>
		<form method="dialog"><button class="flyout__close" type="submit" aria-label="Close">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "cross", Size = IconSize.Small }))</button></form>
	</header>
	<div class="flyout__body">@Model.Body</div>
</dialog>
