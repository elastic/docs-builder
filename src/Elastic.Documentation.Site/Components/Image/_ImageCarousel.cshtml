@inherits RazorSlice<Elastic.Documentation.Site.Components.Image.ImageCarouselModel>
<div class="carousel" data-carousel@(Model.StyleAttribute is { } style ? new HtmlString($" style=\"{System.Net.WebUtility.HtmlEncode(style)}\"") : HtmlString.Empty)>
	<div class="carousel__track" data-carousel-track tabindex="0" role="group" aria-roledescription="carousel" aria-label="Images">
		@for (var i = 0; i < Model.Images.Count; i++)
		{
			var image = Model.Images[i];
			<div class="carousel__slide" role="group" aria-roledescription="slide" aria-label="@(i + 1) of @Model.Images.Count">
				<a class="image-reference image__link" href="@image.Src" hx-boost="false" data-lightbox="@image.DialogId"><img class="carousel__img" title="@image.Title" alt="@image.Alt" src="@image.Src"@(image.Style is { Length: > 0 } imageStyle ? new HtmlString($" style=\"{System.Net.WebUtility.HtmlEncode(imageStyle)}\"") : HtmlString.Empty)></a>
			</div>
		}
	</div>
	@if (Model.Images.Count > 1)
	{
		<div class="carousel__controls" data-carousel-controls hidden>
			<button class="carousel__button" type="button" data-carousel-prev aria-label="Previous slide">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "arrow_left", Size = IconSize.Small }))</button>
			<div class="carousel__dots">
				@for (var i = 0; i < Model.Images.Count; i++)
				{
					<button class="carousel__dot" type="button" data-carousel-dot="@i" aria-label="Go to slide @(i + 1)" aria-current="@(i == 0 ? "true" : "false")"></button>
				}
			</div>
			<button class="carousel__button" type="button" data-carousel-next aria-label="Next slide">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "arrow_right", Size = IconSize.Small }))</button>
		</div>
	}
</div>
@foreach (var image in Model.Images)
{
	@await RenderPartialAsync(_Lightbox.Create(image))
}
