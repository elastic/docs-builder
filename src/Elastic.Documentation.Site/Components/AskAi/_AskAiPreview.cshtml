@inherits RazorSlice<Elastic.Documentation.Site.Components.AskAi.AskAiModel>
@* The panel as it looks mid-conversation, drawn in place and inert: it has no script hooks, so it stays a picture. *@
<div class="flyout ask-ai ask-ai--preview" inert>
	<header class="flyout__header">
		<h2 class="flyout__title">@Model.Title</h2>
		<div class="ask-ai__header-actions">
			<span class="ask-ai__new">New chat</span>
			<span class="flyout__close">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "cross", Size = IconSize.Small }))</span>
		</div>
	</header>
	<div class="ask-ai__body">
		<ol class="ask-ai__messages" aria-label="Conversation">
			<li class="ask-ai__message" data-role="user"><div class="ask-ai__text prose">How do I create an index?</div></li>
			<li class="ask-ai__message" data-role="assistant"><div class="ask-ai__text prose"><p>Send a <code>PUT</code> request with the index name. Mappings and settings are optional:</p><p><code>PUT /products</code></p></div></li>
		</ol>
	</div>
	<div class="ask-ai__form">
		<div class="ask-ai__field">
			<textarea class="input ask-ai__input" rows="1" placeholder="@Model.Placeholder" aria-label="Message"></textarea>
			<span class="ask-ai__send">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "arrow_right", Size = IconSize.Small }))</span>
		</div>
		<p class="ask-ai__legal">AI answers can be wrong. Check them against the documentation.</p>
	</div>
</div>
