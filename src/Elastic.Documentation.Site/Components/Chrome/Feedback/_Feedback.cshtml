@inherits RazorSlice<Elastic.Documentation.Site.Components.Chrome.Feedback.FeedbackModel>
@* The widget needs JavaScript to send anything, so it stays hidden until the script reveals it. *@
<section class="feedback" data-feedback hidden
	data-feedback-page-url="@Model.PageUrl"
	data-feedback-page-title="@Model.PageTitle"
	data-feedback-api="@Model.ApiBase/v1/page-feedback"
	data-feedback-reason-version="@FeedbackReasons.Version">
	<div class="feedback__prompt" data-feedback-prompt>
		<p class="feedback__question" id="@(Model.IdPrefix)-question">Was this page helpful?</p>
		<div class="feedback__choices" role="group" aria-labelledby="@(Model.IdPrefix)-question">
			<button class="btn btn--secondary btn--sm" type="button" data-feedback-reaction="thumbsUp" aria-pressed="false" aria-label="Yes, this page was helpful">
				@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "thumb_up", Size = IconSize.Small }))
				<span>Yes</span>
			</button>
			<button class="btn btn--secondary btn--sm" type="button" data-feedback-reaction="thumbsDown" aria-pressed="false" aria-label="No, this page was not helpful">
				@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "thumb_down", Size = IconSize.Small }))
				<span>No</span>
			</button>
		</div>
	</div>
	<form class="feedback__form" data-feedback-form hidden>
		@foreach (var (reaction, legend, reasons) in new[]
		{
			("thumbsUp", "What did you like?", FeedbackReasons.Positive(Model.Surface)),
			("thumbsDown", "What went wrong?", FeedbackReasons.Negative(Model.Surface))
		})
		{
			<fieldset class="feedback__reasons" data-feedback-reasons="@reaction" hidden>
				<legend class="feedback__legend">@legend</legend>
				@foreach (var reason in reasons)
				{
					<label class="check feedback__reason">
						<input class="check__input" type="checkbox" name="reason" value="@reason.Value" data-feedback-reason>
						<span class="check__box" aria-hidden="true"></span>
						<span class="check__label">
							<span class="feedback__reason-label">@reason.Label</span>
							@if (reason.Description is { } description)
							{
								<span class="feedback__reason-description">@description</span>
							}
						</span>
					</label>
				}
			</fieldset>
		}
		<div class="feedback__details">
			<label class="feedback__sr-only" for="@(Model.IdPrefix)-comment">Tell us more (optional)</label>
			<textarea class="input feedback__textarea" id="@(Model.IdPrefix)-comment" data-feedback-comment maxlength="@FeedbackReasons.CommentMaxLength" placeholder="Tell us more (optional)" aria-describedby="@(Model.IdPrefix)-guidance"></textarea>
			<div class="feedback__footer">
				<p class="feedback__guidance" id="@(Model.IdPrefix)-guidance">Don't include passwords, API keys, or other sensitive information.</p>
				<span class="feedback__count" data-feedback-count>0/@FeedbackReasons.CommentMaxLength</span>
			</div>
		</div>
		<div class="feedback__actions">
			<button class="btn btn--primary btn--sm" type="submit" data-feedback-submit disabled>Submit</button>
			<p class="feedback__error" role="alert" data-feedback-error hidden>We couldn't save your feedback.</p>
		</div>
	</form>
	<p class="feedback__thanks" role="status" data-feedback-thanks hidden>
		@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "check_circle_fill", Size = IconSize.Small }))
		<span>Thank you for your feedback.</span>
	</p>
</section>
