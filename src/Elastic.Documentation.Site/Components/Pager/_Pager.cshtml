@inherits RazorSlice<Elastic.Documentation.Site.Components.Pager.PagerModel>
<nav class="pager" aria-label="Pagination">
	@if (Model.Previous is { } previous)
	{
		<a class="pager__link" href="@previous.Href" rel="prev">
			@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "arrow_left", Size = IconSize.Small }))
			<span class="pager__text">
				<span class="pager__label">Previous</span>
				<span class="pager__title">@previous.Title</span>
			</span>
		</a>
	}
	@if (Model.Next is { } next)
	{
		<a class="pager__link pager__link--next" href="@next.Href" rel="next">
			<span class="pager__text">
				<span class="pager__label">Next</span>
				<span class="pager__title">@next.Title</span>
			</span>
			@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "arrow_right", Size = IconSize.Small }))
		</a>
	}
</nav>
