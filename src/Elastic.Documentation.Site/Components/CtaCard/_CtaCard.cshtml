@inherits RazorSlice<Elastic.Documentation.Site.Components.CtaCard.CtaCardModel>
<aside class="cta-card">
	<a class="btn btn--primary" href="@Model.Url" data-cta="@Model.Name" data-cta-url="@Model.Url" data-cta-label="@Model.Label" data-cta-location="sidebar">@Model.Label</a>
	@if (Model.Benefits.Count > 0)
	{
		<ul class="cta-card__list">
			@foreach (var benefit in Model.Benefits)
			{
				<li>@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "check_circle_fill", Size = IconSize.Small }))<span>@benefit</span></li>
			}
		</ul>
	}
</aside>
