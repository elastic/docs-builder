@inherits RazorSlice<Elastic.Documentation.Site.Components.Icon.IconModel>
@using Elastic.Documentation.Svg
@if (EuiSvgIcons.GetIcon(Model.Name, Model.CssClass) is { } svg)
{
	@(new HtmlString(svg))
}
else
{
	@* An unknown name must be visible in markup so a test can catch it; a silent blank icon is easy to ship. *@
	@(new HtmlString($"<!-- unknown icon '{System.Net.WebUtility.HtmlEncode(Model.Name)}' -->"))
}
