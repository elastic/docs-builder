@inherits RazorSlice<Elastic.Documentation.Site.Components.Button.ButtonModel>
@if (Model.Href is { } href && !Model.Disabled)
{
	<a class="@Model.CssClass" href="@href"@(Model.Download ? new HtmlString(" download") : HtmlString.Empty)@Model.DataAttributes@(Model.IconOnly ? new HtmlString($" aria-label=\"{System.Net.WebUtility.HtmlEncode(Model.Label)}\"") : HtmlString.Empty)>
		@await RenderPartialAsync(_ButtonContent.Create(Model))
	</a>
}
else
{
	<button class="@Model.CssClass" type="button"@Model.DataAttributes@(Model.Disabled ? new HtmlString(" disabled") : HtmlString.Empty)@(Model.IconOnly ? new HtmlString($" aria-label=\"{System.Net.WebUtility.HtmlEncode(Model.Label)}\"") : HtmlString.Empty)>
		@await RenderPartialAsync(_ButtonContent.Create(Model))
	</button>
}
