@inherits RazorSlice<Elastic.Documentation.Site.Components.PageActions.PageActionsModel>
<ul class="page-actions">
	@if (Model.MarkdownUrl is { } markdown)
	{
		<li><a class="page-actions__link" href="@markdown" target="_blank" rel="noopener">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "document", Size = IconSize.Small }))<span>View as Markdown</span></a></li>
	}
	@if (Model.ReportIssueUrl is { } issue)
	{
		<li><a class="page-actions__link" href="@issue" target="_blank" rel="noopener">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "flag", Size = IconSize.Small }))<span>Report a docs issue</span></a></li>
	}
	@if (Model.EditUrl is { } edit)
	{
		<li><a class="page-actions__link" href="@edit" target="_blank" rel="noopener">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "pencil", Size = IconSize.Small }))<span>Edit this page</span></a></li>
	}
	@if (Model.ContributeUrl is { } contribute)
	{
		<li><a class="page-actions__link" href="@contribute" target="_blank" rel="noopener">@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "help", Size = IconSize.Small }))<span>Learn how to contribute</span></a></li>
	}
</ul>
