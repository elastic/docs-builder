@inherits RazorSlice<Elastic.Documentation.Site.Components.Segmented.SegmentedModel>
<fieldset class="segmented">
	<legend class="sr-only">@Model.Legend</legend>
	@foreach (var option in Model.Options)
	{
		<label class="segmented__option">
			<input class="segmented__input" type="radio" name="@Model.Name" value="@option.Value"@(option.Selected ? new HtmlString(" checked") : HtmlString.Empty)>
			<span class="segmented__label">@option.Label</span>
		</label>
	}
</fieldset>
