@inherits RazorSlice<Elastic.Documentation.Site.Components.Tooltip.TooltipModel>
<span class="tooltip@(Model.Open ? " tooltip--open" : "")"><span class="tooltip__trigger" tabindex="0" aria-describedby="@Model.Id">@Model.Label</span><span class="tooltip__bubble" role="tooltip" id="@Model.Id">@Model.Text</span></span>
