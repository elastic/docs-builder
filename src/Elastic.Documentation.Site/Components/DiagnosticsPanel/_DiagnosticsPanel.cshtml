@inherits RazorSlice<Elastic.Documentation.Site.Components.DiagnosticsPanel.DiagnosticsPanelModel>
@* Live build output cannot exist without script, so the panel stays hidden until the script reveals it. *@
<aside class="diagnostics" data-diagnostics data-state="connecting" aria-label="Build diagnostics" hidden>
	<div class="diagnostics__hud" id="diagnostics-hud" data-diagnostics-hud hidden>
		<div class="diagnostics__resize" role="separator" aria-orientation="horizontal" aria-label="Resize diagnostics panel" tabindex="0" data-diagnostics-resize></div>
		<div class="diagnostics__toolbar">
			<div class="diagnostics__filters" role="group" aria-label="Filter diagnostics">
				<button class="diagnostics__filter" type="button" data-diagnostics-filter="all" aria-pressed="true">All</button>
				<button class="diagnostics__filter" type="button" data-diagnostics-filter="error" aria-pressed="false">Errors</button>
				<button class="diagnostics__filter" type="button" data-diagnostics-filter="warning" aria-pressed="false">Warnings</button>
				<button class="diagnostics__filter" type="button" data-diagnostics-filter="hint" aria-pressed="false">Hints</button>
			</div>
			<button class="diagnostics__close" type="button" data-diagnostics-close aria-label="Close diagnostics panel">Close</button>
		</div>
		<ol class="diagnostics__list" data-diagnostics-list></ol>
		<p class="diagnostics__empty" data-diagnostics-empty>No messages to display</p>
	</div>
	<button class="diagnostics__bar" type="button" data-diagnostics-toggle aria-expanded="false" aria-controls="diagnostics-hud">
		<span class="diagnostics__summary" data-diagnostics-summary>Connecting…</span>
		<span class="diagnostics__action" data-diagnostics-action>Show Console</span>
	</button>
	<template data-diagnostics-row>
		<li class="diagnostics__row">
			<div class="diagnostics__meta">
				<span class="diagnostics__severity"></span>
				<span class="diagnostics__location"></span>
			</div>
			<p class="diagnostics__message"></p>
			<button class="diagnostics__copy" type="button" data-diagnostics-copy>Copy</button>
		</li>
	</template>
</aside>
