@inherits RazorSlice<Elastic.Documentation.Site.Components.Primitives.Tooltip.TooltipModel>
@if (Model.Open)
{
<span class="tooltip-shown"><span class="tooltip" aria-hidden="true">@Model.Text</span><span class="tooltip-trigger" tabindex="0" data-tooltip="@Model.Text">@Model.Label</span></span>
}
else
{
<span class="tooltip-trigger" tabindex="0" data-tooltip="@Model.Text">@Model.Label</span>
}
