@inherits RazorSlice<Elastic.Documentation.Site.Components.Navigation.LinkMenu.LinkMenuModel>
<details class="link-menu" data-menu>
	<summary class="link-menu__trigger" aria-label="@Model.Label: @Model.TriggerText">
		<span class="link-menu__current">@Model.TriggerText</span>
		@await RenderPartialAsync(_Icon.Create(new IconModel { Name = "chevron_single_down", Size = IconSize.Small }))
	</summary>
	<ul class="link-menu__list">
		@foreach (var item in Model.Items)
		{
			<li>
				<a class="link-menu__item" href="@item.Url"@(item.Active ? new HtmlString(" aria-current=\"true\"") : HtmlString.Empty)@(item.External ? new HtmlString(" rel=\"noopener\" target=\"_blank\"") : HtmlString.Empty)@(item.Download ? new HtmlString(" download hx-boost=\"false\"") : HtmlString.Empty)>@item.Title</a>
			</li>
		}
		@if (Model.Footer is { } footer)
		{
			<li class="link-menu__footer"><a class="link-menu__item" href="@footer.Url">@footer.Title</a></li>
		}
	</ul>
</details>
