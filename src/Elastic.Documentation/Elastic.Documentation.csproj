<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Elastic.Documentation</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1571;CS1570;CS1574;CS0419</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Mapping" />
    <PackageReference Include="Generator.Equals" />
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="NetEscapades.EnumGenerators"/>
    <PackageReference Include="Nullean.ScopedFileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- The raw wire-format readers (LinkJson.Deserialize*) are internal: the checked loaders in Configuration are the only way to a record. -->
    <InternalsVisibleTo Include="Elastic.Documentation.Configuration" />
    <!-- The compile-time guard: aggregate setters and constructors are internal, so production code outside this assembly and Configuration cannot create or edit one. Tests build records by hand. Never add a production assembly here. -->
    <InternalsVisibleTo Include="Elastic.ApiExplorer.Tests" />
    <InternalsVisibleTo Include="Elastic.Authoring.Tests" />
    <InternalsVisibleTo Include="Elastic.Changelog.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Api.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Api.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Build.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Configuration.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Deploying.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Indexing.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Integrations.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.LegacyDocs.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.OpenApiIndex.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.Tests" />
    <InternalsVisibleTo Include="Elastic.LegacyDocs.Migration.Tests" />
    <InternalsVisibleTo Include="Elastic.Markdown.Tests" />
    <InternalsVisibleTo Include="Elastic.SiteSearch.Tests" />
    <InternalsVisibleTo Include="Mcp.Remote.Tests" />
    <InternalsVisibleTo Include="Navigation.Tests" />
    <InternalsVisibleTo Include="Elastic.Documentation.IntegrationTests" />
    <InternalsVisibleTo Include="Mcp.Remote.IntegrationTests" />
    <InternalsVisibleTo Include="Search.IntegrationTests" />
    <InternalsVisibleTo Include="Elastic.ContentDateEnrichment.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\services\search\Elastic.Documentation.Search.Contract\Elastic.Documentation.Search.Contract.csproj" />
    <!-- The core only: no CsCheck, no Rx, trim and AOT clean. -->
    <ProjectReference Include="$(NulleanEntitiesProject)" />
    <ProjectReference Include="$(NulleanEntitiesGeneratorProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
