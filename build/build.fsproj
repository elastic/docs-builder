<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET SDK 10.0.403 annotates Path.GetExtension as nullable and 10.0.404 does not, so no code form compiles cleanly under both.
         FS3261 and FS3262 are the nullness diagnostics that disagree. -->
    <NoWarn>$(NoWarn);NU1701;FS3261;FS3262</NoWarn>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nullean.Make.Fs" />
    <PackageReference Include="Proc.Fs" />
    <PackageReference Include="Fake.Tools.Git" />
    <PackageReference Include="Fake.IO.Zip" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BuildInformation.fs"/>
    <Compile Include="Targets.fs"/>
    <Compile Include="Program.fs"/>

    <None Include="**\*"/>
    <None Remove="bin\**"/>
    <None Remove="obj\**"/>
    <None Remove="*.fsproj"/>
  </ItemGroup>

</Project>
