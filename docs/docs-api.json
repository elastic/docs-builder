  "components": {
    "schemas": {
      "ApiField": {
        "required": [
          "name",
          "path",
          "type",
          "location",
          "description"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ApiListResponse": {
        "required": [
          "apis"
        ],
        "type": "object",
        "properties": {
          "apis": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiSummary"
            }
          }
        }
      },
      "ApiOperationCollectionResponse": {
        "required": [
          "totalHits",
          "results"
        ],
        "type": "object",
        "properties": {
          "totalHits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiOperationItem"
            }
          }
        }
      },
      "ApiOperationGroupDto": {
        "required": [
          "name",
          "count"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "operations": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ApiOperationListItemDto"
            }
          }
        }
      },
      "ApiOperationItem": {
        "required": [
          "operation"
        ],
        "type": "object",
        "properties": {
          "operation": {
            "$ref": "#/components/schemas/ApiOperationSummary"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "float"
          },
          "matchedFields": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ApiField"
            }
          },
          "versions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ApiField"
            }
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ApiOperationListItemDto": {
        "required": [
          "title",
          "url",
          "method",
          "path",
          "operationId"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          },
          "deprecated": {
            "type": "boolean"
          }
        }
      },
      "ApiOperationListResponse": {
        "required": [
          "api",
          "totalOperations",
          "groups"
        ],
        "type": "object",
        "properties": {
          "api": {
            "type": "string"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "totalOperations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
