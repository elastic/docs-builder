<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- MinVer: only run in CI or Release builds to speed up local development -->
  <Choose>
    <When Condition="'$(CI)' == 'true' OR '$(Configuration)' == 'Release'">
      <PropertyGroup>
        <MinVerSkip>false</MinVerSkip>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <MinVerSkip>true</MinVerSkip>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
    <GlobalPackageReference Include="curb" Version="0.14.3" PrivateAssets="All" />
  </ItemGroup>
  <!-- AWS -->
  <ItemGroup>
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.3.1" />
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageVersion Include="Amazon.Lambda.S3Events" Version="4.0.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.SQSEvents" Version="3.0.1" />
    <PackageVersion Include="AngleSharp" Version="1.10.2" />
    <PackageVersion Include="HtmlSanitizer" Version="11.0.26" />
    <PackageVersion Include="AWSSDK.CloudFront" Version="4.1.0" />
    <PackageVersion Include="Elastic.Transport" Version="1.1.0" />
    <PackageVersion Include="AWSSDK.Core" Version="4.1.0" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.1.0" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.1.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
    <PackageVersion Include="Elastic.OpenTelemetry" Version="1.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Nullean.ScopedFileSystem" Version="0.6.0" />
    <PackageVersion Include="Pagefind.Net" Version="0.5.0" />
    <PackageVersion Include="Pagefind.Net.Frontend" Version="0.5.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="Generator.Equals" Version="4.1.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.5.3" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Elastic.Ingest.Elasticsearch" Version="0.56.0" />
    <PackageVersion Include="Elastic.Mapping" Version="0.56.0" />
    <PackageVersion Include="Elastic.Transport.VirtualizedCluster" Version="1.1.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="TUnit" Version="1.83.8" />
    <!-- The TUnit package pulls these in. Test projects exclude their assets: nothing here uses code coverage or sends test telemetry,
         and the coverage extension copies about 43 MB of native runtimes into every test project's output. Keep the versions in line with TUnit's dependencies. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="WireMock.Net" Version="2.30.0" />
  </ItemGroup>
  <!-- Build -->
  <ItemGroup>
    <PackageVersion Include="Nullean.Make.Fs" Version="0.29.0" />
    <PackageVersion Include="Proc.Fs" Version="0.22.0" />
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Nullean.Argh" Version="0.29.0" />
    <PackageVersion Include="Nullean.Argh.Hosting" Version="0.29.0" />
    <PackageVersion Include="Nullean.Argh.Interfaces" Version="0.29.0" />
    <PackageVersion Include="Crayon" Version="2.0.69" />
    <PackageVersion Include="DotNet.Glob" Version="3.1.3" />
    <PackageVersion Include="Errata" Version="0.16.0" />
    <PackageVersion Include="Github.Actions.Core" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Mermaider" Version="0.17.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="NetEscapades.EnumGenerators" Version="1.0.0-beta12" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageVersion Include="Proc" Version="0.22.0" />
    <PackageVersion Include="RazorSlices" Version="0.12.2" />
    <PackageVersion Include="Sep" Version="0.18.0" />
    <PackageVersion Include="Slugify.Core" Version="4.0.1" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="SoftCircuits.IniFileParser" Version="3.1.2" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="SharpYaml" Version="3.17.0" />
    <PackageVersion Include="Utf8StreamReader" Version="1.3.2" />
    <PackageVersion Include="Westwind.AspNetCore.LiveReload" Version="0.7.2" />
  </ItemGroup>
  <!-- Test packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
  <!-- Transitive pins: force vulnerable indirect dependencies to safe versions -->
  <ItemGroup>
    <!-- SSH.NET 2024.2.0 has GHSA-q939-rpr3-3284 (high); pin to 2026.0.0 -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Scriban.Signed 5.5.0 has multiple CVEs (GHSA-5wr9-m6jw-xx44 critical, etc.); pin to 7.2.6 -->
    <PackageVersion Include="Scriban.Signed" Version="7.6.1" />
    <!-- System.Linq.Dynamic.Core 1.3.12 has GHSA-4cv2-4hjh-77rx (high); pin to 1.7.3 -->
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>
  <!-- Test packages -->
  <ItemGroup>
    <PackageVersion Include="Nullean.Snapshots" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.AwesomeAssertions" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Html" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Http" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Http.Assertions" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Json" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Yaml" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.TUnit" Version="0.11.0" />
    <PackageVersion Include="Nullean.HttpFileParser" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Browser" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Browser.Console" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Browser.Assertions" Version="0.11.0" />
    <PackageVersion Include="Nullean.Cdp" Version="0.11.1" />
    <PackageVersion Include="Nullean.Cdp.Journeys" Version="0.11.1" />
    <PackageVersion Include="AutoBogus" Version="2.13.1" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="Testcontainers.Elasticsearch" Version="4.16.0" />
  </ItemGroup>
</Project>